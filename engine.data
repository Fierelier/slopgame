local function wheel(name, x, y, z, o)
	return {
		name = name,
		mount = {x, y, z},
		axle = o.axle,
		suspension = o.suspension,
		tire = o.tire,
		steer = o.steer or 0,
		drive = o.drive or 0,
		brake = o.brake or 0,
		handbrake = o.handbrake or 0,
	}
end

local function axle_pair(axle, x, y, z, o)
	return wheel(axle .. "_left", -x, y, z, {axle = axle, suspension = o.suspension, tire = o.tire, steer = o.steer, drive = o.drive, brake = o.brake, handbrake = o.handbrake}),
		wheel(axle .. "_right", x, y, z, {axle = axle, suspension = o.suspension, tire = o.tire, steer = o.steer, drive = o.drive, brake = o.brake, handbrake = o.handbrake})
end

local function wheels(...)
	local list = {}
	for _, pair in ipairs({...}) do
		local a, b = axle_pair(table.unpack(pair))
		list[#list + 1] = a
		list[#list + 1] = b
	end
	return list
end

