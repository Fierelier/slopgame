package.path = "./?.lua;engine/lua/?.lua;" .. package.path

local width, height, scale = 480, 320, 1
local positional = {}
for _, a in ipairs({table.unpack(arg, 2)}) do
	local w, h = a:match("^(%d+)[xX](%d+)$")
	local s = a:match("^%-%-scale=(%d+)$")
	if w then
		width, height = tonumber(w), tonumber(h)
	elseif s then
		scale = tonumber(s)
	else
		positional[#positional + 1] = a
	end
end
local max_frames = tonumber(positional[1])
local shot_path = positional[2]

local app = require("game.app")
local target = assert(screen.open(width, height, "game", scale))
audio.open()
target:add_depth()
local scene = app.new(target)

local frame = 0
local accumulator = 0
local running = true
local real_last = screen.time()
local virtual_now = real_last
local last = virtual_now
while running do
	while true do
		local event = screen.poll()
		if not event then break end
		if event.type == "quit" or (event.type == "key" and event.down and event.key == 41) then
			running = false
		else
			scene:on_event(event)
		end
	end
	local real = screen.time()
	if real > real_last then virtual_now = virtual_now + (real - real_last) end
	real_last = real
	local real_dt = math.max(0, (virtual_now - last) / 1000)
	last = virtual_now
	local step = 1 / scene.tick_rate
	if max_frames then
		render.tick()
		scene:update(step)
		scene:draw(1, step)
	else
		accumulator = math.min(accumulator + real_dt, step * scene.max_catchup)
		while accumulator >= step do
			render.tick()
			scene:update(step)
			accumulator = accumulator - step
		end
		scene:draw(accumulator / step, math.min(real_dt, 0.1))
	end
	screen.flush()
	frame = frame + 1
	if max_frames and frame >= max_frames then
		if shot_path then assert(target:save(shot_path)) end
		running = false
	end
	screen.sleep(1)
end
scene.world:shutdown()
screen.close()
local assets = require("game.assets")

local particles = {}
particles.__index = particles

local fade_levels = {1, 0.7, 0.4, 0.15}
local floor, sqrt = math.floor, math.sqrt

function particles.new(world, cfg)
	local self = setmetatable({}, particles)
	self.world = world
	self.cfg = cfg
	self.live = {}
	self.count = 0
	self.pool = {}
	self.sets = {}
	self.seed = 20241
	return self
end

function particles:random()
	self.seed = (self.seed * 1103515245 + 12345) % 2147483648
	return self.seed / 2147483648
end

function particles:range(r)
	return r[1] + (r[2] - r[1]) * self:random()
end

function particles:texture_set(effect)
	local set = self.sets[effect]
	if set then return set end
	set = {}
	local base = effect.alpha or 140
	for i = 1, #fade_levels do
		local entry = self.world.assets:acquire(assets.texture_gen("puff", {color = effect.color, alpha = base * fade_levels[i], size = effect.texture_size or 16}))
		self.world.assets:ensure_now(entry)
		set[i] = entry
	end
	self.sets[effect] = set
	return set
end

function particles:spawn(effect, x, y, z, vx, vy, vz)
	if self.count >= self.cfg.max then return end
	local set = self:texture_set(effect)
	local first = set[1].handle
	if not first then return end
	local list = self.world.scene
	local p = table.remove(self.pool)
	local size0 = self:range(effect.size_start)
	if not p then
		p = {pos = {0, 0, 0}, size = {1, 1}}
		p.fields = {pos = p.pos, size = p.size}
		p.id = list:add_billboard(first, {pos = p.pos, size = p.size, blend = "blend", sun = false, points = false})
	else
		p.pos[1], p.pos[2], p.pos[3] = x, y, z
		p.size[1], p.size[2] = size0, size0
		list:set(p.id, p.fields)
		list:set_texture(p.id, first)
		list:snap(p.id)
		list:set_visible(p.id, true)
	end
	p.pos[1], p.pos[2], p.pos[3] = x, y, z
	p.size[1], p.size[2] = size0, size0
	p.vx, p.vy, p.vz = vx, vy, vz
	p.age = 0
	p.life = self:range(effect.life)
	p.size0 = size0
	p.size1 = self:range(effect.size_end)
	p.effect = effect
	p.set = set
	p.level = 1
	self.count = self.count + 1
	self.live[self.count] = p
end

function particles:update(dt)
	local list = self.world.scene
	local live = self.live
	local i = 1
	while i <= self.count do
		local p = live[i]
		p.age = p.age + dt
		if p.age >= p.life then
			list:set_visible(p.id, false)
			self.pool[#self.pool + 1] = p
			live[i] = live[self.count]
			live[self.count] = nil
			self.count = self.count - 1
		else
			local e = p.effect
			local damp = 1 - e.drag * dt
			if damp < 0 then damp = 0 end
			p.vx, p.vz = p.vx * damp, p.vz * damp
			p.vy = p.vy * damp + e.rise * dt
			local pos = p.pos
			pos[1], pos[2], pos[3] = pos[1] + p.vx * dt, pos[2] + p.vy * dt, pos[3] + p.vz * dt
			local t = p.age / p.life
			local s = p.size0 + (p.size1 - p.size0) * t
			p.size[1], p.size[2] = s, s
			list:set(p.id, p.fields)
			local level = 1 + floor(t * #fade_levels)
			if level > #fade_levels then level = #fade_levels end
			if level ~= p.level then
				p.level = level
				local h = p.set[level].handle
				if h then list:set_texture(p.id, h) end
			end
			i = i + 1
		end
	end
end

local smoke_defaults = {
	min_slide_speed = 2.0,
	speed_reference = 8,
	rate = 40,
	alpha = 230,
	texture_size = 16,
	life = {0.6, 1.2},
	size_start = {0.4, 0.6},
	size_end = {1.1, 1.8},
	inherit = 0.35,
	spread = 1.2,
	lift = 0.9,
	rise = 0.6,
	drag = 1.6,
	height = 0.1,
}

function particles:smoke_effect(tire)
	local color = tire.prefab.smoke
	if not color then return nil end
	local cache = self.smoke_cache
	if not cache then
		cache = {}
		self.smoke_cache = cache
	end
	local effect = cache[tire.prefab]
	if not effect then
		effect = {color = color}
		for k, v in pairs(smoke_defaults) do effect[k] = v end
		cache[tire.prefab] = effect
	end
	return effect
end

function particles:slide_intensity(tire, effect)
	if not tire.contact_ok then return 0 end
	local intensity = tire.slip_norm - 1
	if intensity <= 0 then return 0 end
	if tire.slide_speed < effect.min_slide_speed then return 0 end
	local k = tire.slide_speed / effect.speed_reference
	if k > 1 then k = 1 end
	return intensity * k
end

function particles:slide(tire, dt, vx, vy, vz)
	local effect = self:smoke_effect(tire)
	if not effect then return end
	local intensity = self:slide_intensity(tire, effect)
	if intensity <= 0 then
		tire.emit_acc = 0
		return
	end
	local focus = self.world.focus
	if focus and focus.pos then
		local fp = focus.pos
		local dx, dz = tire.cx - fp[1], tire.cz - fp[3]
		local md = self.cfg.max_distance
		if dx * dx + dz * dz > md * md then return end
	end
	local acc = (tire.emit_acc or 0) + effect.rate * intensity * dt
	local n = floor(acc)
	tire.emit_acc = acc - n
	local inherit = effect.inherit
	local spread = effect.spread
	for _ = 1, n do
		local jx = (self:random() - 0.5) * spread
		local jz = (self:random() - 0.5) * spread
		self:spawn(effect, tire.cx + jx * 0.3, tire.cy + effect.height, tire.cz + jz * 0.3,
			vx * inherit + jx, effect.lift * (0.5 + self:random()), vz * inherit + jz)
	end
end

function particles:clear()
	local list = self.world.scene
	for i = 1, self.count do
		local p = self.live[i]
		list:set_visible(p.id, false)
		self.pool[#self.pool + 1] = p
		self.live[i] = nil
	end
	self.count = 0
end

return particles
local texgen = {}

local color = texture.color

local function c(t, default)
	t = t or default
	return color(t[1], t[2], t[3], t[4] or 255)
end

function texgen.solid(a)
	return texture.new(a.size or 8, a.size or 8, c(a.color, {200, 200, 200}))
end

function texgen.checker(a)
	local size = a.size or 16
	local half = size // 2
	local t = texture.new(size, size, c(a.a, {230, 230, 235}))
	local b = c(a.b, {140, 150, 190})
	t:fill(b, 1, 1, half, half)
	t:fill(b, half + 1, half + 1, size, size)
	return t
end

function texgen.grid(a)
	local size = a.size or 64
	local t = texture.new(size, size, c(a.base, {78, 140, 76}))
	local line = c(a.line, {120, 180, 110})
	t:fill(line, 1, 1, size, 1)
	t:fill(line, 1, 1, 1, size)
	local mid = c(a.mid, {98, 160, 92})
	t:fill(mid, 1, size // 2 + 1, size, size // 2 + 1)
	t:fill(mid, size // 2 + 1, 1, size // 2 + 1, size)
	return t
end

function texgen.speckle(a)
	local size = a.size or 32
	local t = texture.new(size, size, c(a.base, {70, 120, 60}))
	local alt = c(a.alt, {60, 105, 52})
	local seed = a.seed or 7
	for i = 1, size * size // 6 do
		seed = (seed * 1103515245 + 12345) % 2147483648
		local x = seed % size + 1
		seed = (seed * 1103515245 + 12345) % 2147483648
		local y = seed % size + 1
		t:set_pixel(x, y, alt)
	end
	return t
end

function texgen.gradient(a)
	local size = a.size or 16
	local t = texture.new(size, size, 0xFFFF)
	t:gradient(c(a.top, {255, 255, 255}), c(a.bottom, {80, 80, 90}), "vertical", true)
	return t
end

function texgen.stripes(a)
	local size = a.size or 32
	local t = texture.new(size, size, c(a.base, {200, 60, 50}))
	local stripe = c(a.stripe, {240, 240, 240})
	local width = a.width or 4
	for x = 1, size, width * 2 do
		t:fill(stripe, x, 1, math.min(x + width - 1, size), size)
	end
	return t
end

function texgen.tread(a)
	local t = texture.new(32, 16, c(a.base, {28, 28, 32}))
	local light = c(a.tread, {70, 70, 78})
	for x = 1, 32, 8 do
		t:fill(light, x, 1, x + 2, 16)
	end
	t:fill(c(a.hub, {200, 200, 210}), 1, 7, 32, 10)
	return t
end

function texgen.window(a)
	local t = texture.new(16, 16, c(a.base, {40, 70, 120}))
	t:gradient(c(a.top, {120, 190, 240}), c(a.bottom, {30, 60, 110}), "vertical", true)
	return t
end

function texgen.puff(a)
	local size = a.size or 16
	local col = a.color or {220, 220, 225}
	local alpha = a.alpha or 140
	local t = texture.new(size, size, 0)
	local half = size / 2
	for y = 1, size do
		for x = 1, size do
			local dx, dy = x - half - 0.5, y - half - 0.5
			local f = 1 - math.sqrt(dx * dx + dy * dy) / half
			if f < 0 then f = 0 end
			t:set_pixel(x, y, color(col[1], col[2], col[3], math.floor(f * f * alpha)))
		end
	end
	return t
end

return texgen
local worker = {}

local function build_model(spec)
	if spec.path then return model.load(spec.path) end
	local fn = require("game.modelgen")[spec.gen] or require("meshes")[spec.gen]
	if not fn then return nil, "unknown model generator " .. tostring(spec.gen) end
	return fn(table.unpack(spec.args or {}))
end

local function build_texture(spec)
	if spec.path then
		return texture.load(spec.path, {max_size = spec.max_size})
	end
	local texgen = require("game.texgen")
	local fn = texgen[spec.gen]
	if not fn then return nil, "unknown texture generator " .. tostring(spec.gen) end
	return fn(spec.args or {})
end

function worker.build(spec)
	local started = thread.time()
	local handle, err
	local bounds
	local bytes = 0
	if spec.kind == "model" then
		handle, err = build_model(spec)
		if handle then
			bounds = {handle:bounds()}
			bytes = handle:triangle_count() * 72 + handle:vertex_count() * 12 + handle:uv_count() * 8
		end
	elseif spec.kind == "texture" then
		handle, err = build_texture(spec)
		if handle then bytes = handle:width() * handle:height() * 2 end
	else
		err = "unknown asset kind " .. tostring(spec.kind)
	end
	if not handle then error(err or "asset build failed") end
	return handle, bounds, bytes, thread.time() - started
end

return worker
local util = {}

local sqrt, exp, floor = math.sqrt, math.exp, math.floor

function util.clamp(v, lo, hi)
	if v < lo then return lo end
	if v > hi then return hi end
	return v
end

function util.lerp(a, b, t)
	return a + (b - a) * t
end

function util.approach(v, target, delta)
	if v < target then
		v = v + delta
		if v > target then return target end
	elseif v > target then
		v = v - delta
		if v < target then return target end
	end
	return v
end

function util.damp(v, target, rate, dt)
	return v + (target - v) * (1 - exp(-rate * dt))
end

function util.sign(v)
	if v < 0 then return -1 end
	if v > 0 then return 1 end
	return 0
end

function util.wrap_angle(a)
	a = (a + math.pi) % (2 * math.pi)
	return a - math.pi
end

function util.approach_angle(a, target, delta)
	local diff = util.wrap_angle(target - a)
	if diff > delta then diff = delta elseif diff < -delta then diff = -delta end
	return a + diff
end

function util.normalize(x, y, z)
	local l = sqrt(x * x + y * y + z * z)
	if l < 1e-9 then return 0, 0, 0, 0 end
	return x / l, y / l, z / l, l
end

function util.cross(ax, ay, az, bx, by, bz)
	return ay * bz - az * by, az * bx - ax * bz, ax * by - ay * bx
end

function util.deep_copy(t)
	if type(t) ~= "table" then return t end
	local out = {}
	for k, v in pairs(t) do out[k] = util.deep_copy(v) end
	return out
end

local function is_array(t)
	local n = #t
	if n == 0 then return false end
	for k in pairs(t) do
		if type(k) ~= "number" or k < 1 or k > n or k % 1 ~= 0 then return false end
	end
	return true
end

function util.merge(dst, src)
	for k, v in pairs(src) do
		local existing = dst[k]
		if type(v) == "table" and type(existing) == "table" and not is_array(v) and not is_array(existing) then
			util.merge(existing, v)
		else
			dst[k] = util.deep_copy(v)
		end
	end
	return dst
end

function util.rng(seed)
	local state = seed % 2147483647
	if state <= 0 then state = state + 2147483646 end
	return function()
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
end

function util.vec(v, x, y, z)
	v[1], v[2], v[3] = x, y, z
	return v
end

function util.round(v, step)
	return floor(v / step + 0.5) * step
end

function util.view_vector(yaw, pitch)
	local cp = math.cos(pitch)
	return -math.sin(yaw) * cp, math.sin(pitch), -math.cos(yaw) * cp
end

return util
return {
	tick_rate = 60,
	physics_substeps = 2,
	gravity = -9.8,
	stream = {
		interval_ticks = 6,
		cell_size = 48,
		move_threshold = 1.0,
		critical_margin = 4.0,
		critical_lookahead = 0.6,
		load_radius = 110,
		unload_hysteresis = 1.2,
		collision_rebuild_interval = 0.35,
	},
	background = {
		main_percent = 0.08,
		worker_percent = 0.5,
		max_in_flight = 1,
		worker_priority = -1,
		cache_idle_ttl = 20,
		cache_idle_bytes = 24 * 1024 * 1024,
		max_texture_size = 128,
		gc_step = 2,
	},
	particles = {
		max = 160,
		max_distance = 70,
	},
	render = {
		width = 480,
		height = 320,
		fov = 75,
		near = 0.1,
		far = 140,
	},
	save_path = "quicksave.lua",
}
local meshes = require("meshes")

local modelgen = {}

function modelgen.centered_grid(w, d, nx, nz, per_unit)
	local m = meshes.grid(w, d, nx, nz, per_unit)
	for i = 1, m:vertex_count() do
		local x, y, z = m:get_vertex(i)
		m:set_vertex(i, x - w / 2, y, z - d / 2)
	end
	return m
end

function modelgen.centered_box(w, h, d, tile)
	local m = meshes.box(w, h, d, tile)
	for i = 1, m:vertex_count() do
		local x, y, z = m:get_vertex(i)
		m:set_vertex(i, x, y - h / 2, z)
	end
	return m
end

return modelgen
local assets = require("game.assets")

local visual = {}

local scratch = {pos = {0, 0, 0}, look = {0, 0, -1}, up = {0, 1, 0}}

function visual.acquire(manager, parts)
	local entries = {}
	for i = 1, #parts do
		local part = parts[i]
		local entry
		if part.model and part.texture then
			entry = manager:acquire_textured(part.model, part.texture)
		elseif part.model then
			entry = manager:acquire(part.model)
		end
		entries[i] = {model = entry}
	end
	return entries
end

function visual.release(manager, entries)
	for i = 1, #entries do
		local e = entries[i]
		if e.model then manager:release(e.model) end
		if e.texture then manager:release(e.texture) end
	end
end

local function settled(entry)
	return entry == nil or entry.state == "ready" or entry.state == "failed"
end

function visual.ready(entries)
	for i = 1, #entries do
		local e = entries[i]
		if not settled(e.model) or not settled(e.texture) then return false end
	end
	return true
end

function visual.prioritize(manager, entries, priority)
	for i = 1, #entries do
		local e = entries[i]
		if e.model then manager:prioritize(e.model, priority) end
		if e.texture then manager:prioritize(e.texture, priority) end
	end
end

function visual.ensure_now(manager, entries)
	for i = 1, #entries do
		local e = entries[i]
		if e.model then manager:ensure_now(e.model) end
		if e.texture then manager:ensure_now(e.texture) end
	end
end

function visual.create(list, parts, entries, pose, scale_mul, collide_default)
	local ids = {}
	local px, py, pz = pose.px, pose.py, pose.pz
	local xx, xy, xz = pose.xx, pose.xy, pose.xz
	local yx, yy, yz = pose.yx, pose.yy, pose.yz
	local zx, zy, zz = pose.zx, pose.zy, pose.zz
	for i = 1, #parts do
		local part, e = parts[i], entries[i]
		local handle = e.model and e.model.handle
		if handle then
			local o = part.offset
			local ox, oy, oz = 0, 0, 0
			if o then ox, oy, oz = o[1], o[2], o[3] end
			local sc = part.scale or 1
			local sx, sy, sz
			if type(sc) == "table" then sx, sy, sz = sc[1], sc[2], sc[3] else sx, sy, sz = sc, sc, sc end
			if scale_mul then
				sx, sy, sz = sx * scale_mul[1], sy * scale_mul[2], sz * scale_mul[3]
				ox, oy, oz = ox * scale_mul[1], oy * scale_mul[2], oz * scale_mul[3]
			end
			local collide = part.collide
			if collide == nil then collide = collide_default end
			local id = list:add(handle, {
				pos = {px + xx * ox + yx * oy + zx * oz, py + xy * ox + yy * oy + zy * oz, pz + xz * ox + yz * oy + zz * oz},
				look = {-zx, -zy, -zz},
				up = {yx, yy, yz},
				scale = {sx, sy, sz},
				sun = part.sun,
				points = part.points,
				blend = part.blend,
				color = part.color,
				collide = collide,
			})
			ids[i] = id
		else
			ids[i] = false
		end
	end
	return ids
end

function visual.destroy(list, ids)
	for i = 1, #ids do
		local id = ids[i]
		if id then list:remove(id) end
	end
end

function visual.set_visible(list, ids, visible)
	for i = 1, #ids do
		local id = ids[i]
		if id then list:set_visible(id, visible) end
	end
end

function visual.snap(list, ids)
	for i = 1, #ids do
		local id = ids[i]
		if id then list:snap(id) end
	end
end

function visual.pose(list, ids, parts, first, last, px, py, pz, xx, xy, xz, yx, yy, yz, zx, zy, zz)
	local pos, look, up = scratch.pos, scratch.look, scratch.up
	look[1], look[2], look[3] = -zx, -zy, -zz
	up[1], up[2], up[3] = yx, yy, yz
	for i = first, last do
		local id = ids[i]
		if id then
			local o = parts[i].offset
			if o then
				local ox, oy, oz = o[1], o[2], o[3]
				pos[1] = px + xx * ox + yx * oy + zx * oz
				pos[2] = py + xy * ox + yy * oy + zy * oz
				pos[3] = pz + xz * ox + yz * oy + zz * oz
			else
				pos[1], pos[2], pos[3] = px, py, pz
			end
			list:set(id, scratch)
		end
	end
end

function visual.yaw_basis(yaw)
	local s, c = math.sin(yaw), math.cos(yaw)
	return c, 0, -s, 0, 1, 0, s, 0, c
end

return visual
local serialize = {}

local format, concat, sort = string.format, table.concat, table.sort

local function key_string(k)
	if type(k) == "string" and k:match("^[%a_][%w_]*$") and k ~= "end" and k ~= "and" and k ~= "or" and k ~= "not" and k ~= "if" and k ~= "then" and k ~= "else" and k ~= "for" and k ~= "while" and k ~= "do" and k ~= "function" and k ~= "return" and k ~= "nil" and k ~= "true" and k ~= "false" and k ~= "in" and k ~= "local" and k ~= "repeat" and k ~= "until" and k ~= "break" and k ~= "goto" and k ~= "elseif" then
		return k
	end
	if type(k) == "string" then return format("[%q]", k) end
	return "[" .. serialize.number(k) .. "]"
end

function serialize.number(v)
	if v ~= v then return "(0/0)" end
	if v == math.huge then return "(1/0)" end
	if v == -math.huge then return "(-1/0)" end
	if math.type(v) == "integer" then return format("%d", v) end
	if v == math.floor(v) and math.abs(v) < 1e15 then return format("%d.0", v) end
	return format("%.14g", v)
end

local function emit(v, out, seen)
	local t = type(v)
	if t == "number" then
		out[#out + 1] = serialize.number(v)
	elseif t == "string" then
		out[#out + 1] = format("%q", v)
	elseif t == "boolean" then
		out[#out + 1] = v and "true" or "false"
	elseif t == "table" then
		if seen[v] then error("serialize: cycle") end
		seen[v] = true
		out[#out + 1] = "{"
		local n = #v
		for i = 1, n do
			emit(v[i], out, seen)
			out[#out + 1] = ","
		end
		local keys = {}
		for k in pairs(v) do
			if not (math.type(k) == "integer" and k >= 1 and k <= n) then keys[#keys + 1] = k end
		end
		sort(keys, function(a, b)
			local ta, tb = type(a), type(b)
			if ta ~= tb then return ta < tb end
			return a < b
		end)
		for i = 1, #keys do
			local k = keys[i]
			out[#out + 1] = key_string(k) .. "="
			emit(v[k], out, seen)
			out[#out + 1] = ","
		end
		out[#out + 1] = "}"
		seen[v] = nil
	else
		error("serialize: unsupported type " .. t)
	end
end

function serialize.to_string(value)
	local out = {"return "}
	emit(value, out, {})
	return concat(out)
end

function serialize.from_string(text)
	local chunk, err = load(text, "=save", "t", {})
	if not chunk then return nil, err end
	local ok, value = pcall(chunk)
	if not ok then return nil, value end
	return value
end

function serialize.write_file(path, value)
	local file, err = io.open(path, "wb")
	if not file then return nil, err end
	file:write(serialize.to_string(value))
	file:close()
	return true
end

function serialize.read_file(path)
	local file, err = io.open(path, "rb")
	if not file then return nil, err end
	local text = file:read("a")
	file:close()
	return serialize.from_string(text)
end

return serialize
local config_default = require("game.config")
local util = require("game.util")
local object = require("game.object")
local assets = require("game.assets")
local input = require("game.input")
local serialize = require("game.serialize")
local prefabs = require("game.prefabs")

local world = {}
world.__index = world

world.SAVE_VERSION = 1

local clock = os.clock
local floor, sqrt, max, min = math.floor, math.sqrt, math.max, math.min

local function load_object_types()
	require("game.objects.world_object")
	require("game.objects.prop")
	require("game.objects.suspension")
	require("game.objects.tire")
	require("game.objects.vehicle")
	require("game.objects.player")
	require("game.objects.camera")
end

local function cell_key(cx, cz)
	return (cx + 16384) * 32768 + (cz + 16384)
end

function world.new(opts)
	load_object_types()
	prefabs.load_all(opts and opts.prefab_modules)
	local self = setmetatable({}, world)
	self.config = util.merge(util.deep_copy(config_default), opts and opts.config or {})
	local cfg = self.config
	self.scene = render.list()
	self.lights = render.lights()
	self.phys = physics.world(self.scene)
	self.phys:set{step = 1 / (cfg.tick_rate * cfg.physics_substeps)}
	self.assets = assets.new(cfg.background)
	self.particles = require("game.particles").new(self, cfg.particles)
	self.input = input.new()
	self.objects = {}
	self.next_id = 1
	self.time = 0
	self.tick = 0
	self.grid = {}
	self.dynamic = {}
	self.vehicles = {}
	self.active = {}
	self.loading = {}
	self.resident_static = {}
	self.max_load_radius = 0
	self.stream_dirty = true
	self.stream_pass = 0
	self.stream_x, self.stream_y, self.stream_z = 1e9, 0, 0
	self.collision_dirty = false
	self.collision_urgent = false
	self.last_rebuild = -1e9
	self.tokens = 0
	self.frame_dt = 1 / 60
	self.focus_id = nil
	self.focus = nil
	self.camera = nil
	self.player = nil
	self.stats = {resident = 0, loading = 0, critical_loads = 0, rebuilds = 0, rebuild_ms = 0, rebuild_max_ms = 0, budget_used_ms = 0, max_tick_ms = 0, objects = 0}
	return self
end

function world:spawn(type_name, prefab, init)
	init = init or {}
	init.prefab = prefab
	local class = object.class(type_name)
	local obj = class.create(class, self, init)
	self:add(obj)
	return obj
end

local function register_grid(self, obj)
	local size = self.config.stream.cell_size
	local cx, cz = floor(obj.pos[1] / size), floor(obj.pos[3] / size)
	local key = cell_key(cx, cz)
	local cell = self.grid[key]
	if not cell then
		cell = {}
		self.grid[key] = cell
	end
	cell[#cell + 1] = obj
	obj.grid_key = key
end

local function unregister_grid(self, obj)
	local cell = self.grid[obj.grid_key]
	if not cell then return end
	for i = 1, #cell do
		if cell[i] == obj then
			cell[i] = cell[#cell]
			cell[#cell] = nil
			break
		end
	end
	if #cell == 0 then self.grid[obj.grid_key] = nil end
end

function world:add(obj)
	if not obj.id then
		obj.id = self.next_id
	end
	if obj.id >= self.next_id then self.next_id = obj.id + 1 end
	self.objects[obj.id] = obj
	self.stats.objects = self.stats.objects + 1
	if not obj.child then
		local cfg = self.config.stream
		obj.critical_r, obj.load_r, obj.unload_r = obj:stream_radii(cfg)
		if obj.dynamic then
			self.dynamic[#self.dynamic + 1] = obj
		else
			register_grid(self, obj)
		end
		if obj.type == "vehicle" then self.vehicles[#self.vehicles + 1] = obj end
		if obj.unload_r > self.max_load_radius then self.max_load_radius = obj.unload_r end
	end
	self.stream_dirty = true
	obj:on_added()
	return obj
end

local function remove_from_array(arr, obj)
	for i = 1, #arr do
		if arr[i] == obj then
			table.remove(arr, i)
			return
		end
	end
end

function world:remove(id)
	local obj = self.objects[id]
	if not obj then return end
	if obj.state ~= "idle" then self:unload(obj) end
	obj:on_removed()
	self.objects[id] = nil
	self.stats.objects = self.stats.objects - 1
	if not obj.child then
		if obj.dynamic then remove_from_array(self.dynamic, obj) else unregister_grid(self, obj) end
		if obj.type == "vehicle" then remove_from_array(self.vehicles, obj) end
	end
	if self.focus == obj then self.focus, self.focus_id = nil, nil end
	self.stream_dirty = true
end

function world:get(id)
	return self.objects[id]
end

function world:set_focus(id)
	self.focus_id = id
	self.focus = self.objects[id]
	self.stream_dirty = true
end

function world:retarget_camera(id)
	if self.camera then self.camera:set_target(id) end
end

function world:begin_load(obj)
	obj:acquire_assets()
	obj.state = "loading"
	self.loading[#self.loading + 1] = obj
end

function world:make_resident(obj)
	obj:on_load()
	obj.state = "resident"
	self.stats.resident = self.stats.resident + 1
	if obj.update or obj.step or obj.post_update then
		local active = self.active
		active[#active + 1] = obj
		local order = obj.update_order or (obj.type == "camera" and 100 or 0)
		obj.order = order
		local i = #active
		while i > 1 and active[i - 1].order > order do
			active[i] = active[i - 1]
			i = i - 1
		end
		active[i] = obj
	end
	if not obj.dynamic then
		self.resident_static[#self.resident_static + 1] = obj
		obj.static_index = #self.resident_static
		if obj.has_colliders then self.collision_dirty = true end
	end
end

function world:finish_loading(obj)
	local list = self.loading
	for i = 1, #list do
		if list[i] == obj then
			list[i] = list[#list]
			list[#list] = nil
			break
		end
	end
end

function world:force_load(obj)
	if obj.state == "resident" then return end
	if obj.state == "idle" then
		obj:acquire_assets()
	else
		self:finish_loading(obj)
	end
	obj:ensure_assets_now()
	self:make_resident(obj)
	self.stats.critical_loads = self.stats.critical_loads + 1
	if obj.has_colliders then self.collision_urgent = true end
end

function world:unload(obj)
	if obj.state == "loading" then
		self:finish_loading(obj)
		obj:release_assets()
		obj.state = "idle"
		return
	end
	if obj.state ~= "resident" then return end
	obj:on_unload()
	obj:release_assets()
	obj.state = "idle"
	self.stats.resident = self.stats.resident - 1
	local active = self.active
	for i = 1, #active do
		if active[i] == obj then
			table.remove(active, i)
			break
		end
	end
	if not obj.dynamic then
		local rs = self.resident_static
		local index = obj.static_index
		local last = rs[#rs]
		rs[index] = last
		last.static_index = index
		rs[#rs] = nil
		if obj.has_colliders then self.collision_dirty = true end
	end
end

local function stream_one(self, obj, fx, fy, fz, critical_extra, pass)
	local p = obj.pos
	local dx, dz = p[1] - fx, p[3] - fz
	local dy = p[2] - fy
	local d2 = dx * dx + dz * dz + dy * dy * 0.25
	local state = obj.state
	if obj.pinned_now then
		if state ~= "resident" then self:force_load(obj) end
		return
	end
	local crit = obj.critical_r + critical_extra
	if state ~= "resident" and d2 <= crit * crit then
		self:force_load(obj)
		return
	end
	if state == "idle" then
		if d2 <= obj.load_r * obj.load_r then
			self:begin_load(obj)
			obj:prioritize_assets(d2)
		end
	elseif state == "loading" then
		if d2 > obj.unload_r * obj.unload_r then
			self:unload(obj)
		else
			obj:prioritize_assets(d2)
		end
	elseif state == "resident" and obj.dynamic then
		if d2 > obj.unload_r * obj.unload_r then self:unload(obj) end
	end
end

function world:stream(force)
	local focus = self.focus
	if not focus then return end
	local fx, fy, fz = focus:position()
	local cfg = self.config.stream
	local dx, dz = fx - self.stream_x, fz - self.stream_z
	if not force and not self.stream_dirty and dx * dx + dz * dz < cfg.move_threshold * cfg.move_threshold then return end
	self.stream_dirty = false
	self.stream_x, self.stream_y, self.stream_z = fx, fy, fz
	self.stream_pass = self.stream_pass + 1
	local pass = self.stream_pass

	local reach = focus.reach and focus:reach() or 0
	local extra = reach + focus:speed() * cfg.critical_lookahead
	local dyn = self.dynamic
	for i = 1, #dyn do
		local obj = dyn[i]
		obj.pinned_now = obj:is_pinned()
		stream_one(self, obj, fx, fy, fz, extra, pass)
	end

	local size = cfg.cell_size
	local radius = self.max_load_radius
	local c0x, c1x = floor((fx - radius) / size), floor((fx + radius) / size)
	local c0z, c1z = floor((fz - radius) / size), floor((fz + radius) / size)
	local grid = self.grid
	for cx = c0x, c1x do
		for cz = c0z, c1z do
			local cell = grid[cell_key(cx, cz)]
			if cell then
				for i = 1, #cell do
					stream_one(self, cell[i], fx, fy, fz, extra, pass)
				end
			end
		end
	end

	local rs = self.resident_static
	local i = 1
	while i <= #rs do
		local obj = rs[i]
		local p = obj.pos
		local ddx, ddz, ddy = p[1] - fx, p[3] - fz, p[2] - fy
		if ddx * ddx + ddz * ddz + ddy * ddy * 0.25 > obj.unload_r * obj.unload_r then
			self:unload(obj)
		else
			i = i + 1
		end
	end

	local loading = self.loading
	i = 1
	while i <= #loading do
		local obj = loading[i]
		local p = obj.pos
		local ddx, ddz, ddy = p[1] - fx, p[3] - fz, p[2] - fy
		local d2 = ddx * ddx + ddz * ddz + ddy * ddy * 0.25
		if d2 > obj.unload_r * obj.unload_r then
			self:unload(obj)
		else
			obj:prioritize_assets(d2)
			i = i + 1
		end
	end
end

function world:process_loading()
	local loading = self.loading
	local i = 1
	while i <= #loading and self.tokens > 0 do
		local obj = loading[i]
		if obj:assets_ready() then
			local t0 = clock()
			loading[i] = loading[#loading]
			loading[#loading] = nil
			self:make_resident(obj)
			self.tokens = self.tokens - (clock() - t0) * 1000
		else
			i = i + 1
		end
	end
end

function world:update_collision()
	if not self.collision_dirty then return end
	local interval = self.config.stream.collision_rebuild_interval
	if self.collision_urgent or (self.tokens > 0 and self.time - self.last_rebuild >= interval) then
		local r0 = clock()
		self.phys:rebuild()
		local ms = (clock() - r0) * 1000
		self.tokens = self.tokens - ms
		self.stats.rebuild_ms = ms
		if ms > self.stats.rebuild_max_ms then self.stats.rebuild_max_ms = ms end
		self.last_rebuild = self.time
		self.collision_dirty = false
		self.collision_urgent = false
		self.stats.rebuilds = self.stats.rebuilds + 1
	end
end

function world:update(dt)
	local t0 = clock()
	local cfg = self.config
	self.time = self.time + dt
	self.tick = self.tick + 1

	local budget_ms = cfg.background.main_percent * 1000 * max(self.frame_dt, dt)
	self.tokens = min(self.tokens + budget_ms, budget_ms * 4)

	if self.tick % cfg.stream.interval_ticks == 0 or self.stream_dirty then self:stream(false) end
	self:process_loading()
	self:update_collision()
	self.assets:update(self.time)

	local active = self.active
	local n = #active
	for i = 1, n do
		local obj = active[i]
		local f = obj.update
		if f then f(obj, dt) end
	end

	local substeps = cfg.physics_substeps
	local h = dt / substeps
	local phys = self.phys
	for s = 1, substeps do
		for i = 1, n do
			local obj = active[i]
			local f = obj.step
			if f then f(obj, h) end
		end
		phys:step(h)
	end

	for i = 1, n do
		local obj = active[i]
		local f = obj.post_update
		if f then f(obj, dt) end
	end

	self.particles:update(dt)
	self.input:end_tick()
	local used = (clock() - t0) * 1000
	self.stats.budget_used_ms = used
	if used > self.stats.max_tick_ms then self.stats.max_tick_ms = used end
	self.stats.loading = #self.loading
end

function world:nearest_resident(type_name, x, y, z, max_distance)
	local best, best_d2 = nil, max_distance * max_distance
	for _, obj in ipairs(self.active) do
		if obj.type == type_name then
			local dx, dy, dz = obj.pos[1] - x, obj.pos[2] - y, obj.pos[3] - z
			local d2 = dx * dx + dy * dy + dz * dz
			if d2 < best_d2 then best, best_d2 = obj, d2 end
		end
	end
	return best
end

function world:clear()
	self.particles:clear()
	local ids = {}
	for id in pairs(self.objects) do ids[#ids + 1] = id end
	for _, id in ipairs(ids) do
		local obj = self.objects[id]
		if obj and obj.state ~= "idle" then self:unload(obj) end
	end
	for _, id in ipairs(ids) do self.objects[id] = nil end
	self.grid = {}
	self.dynamic = {}
	self.vehicles = {}
	self.active = {}
	self.loading = {}
	self.resident_static = {}
	self.max_load_radius = 0
	self.focus, self.focus_id, self.camera, self.player = nil, nil, nil, nil
	self.stats.objects = 0
	self.stats.resident = 0
	self.collision_dirty = true
	self.collision_urgent = true
	self:update_collision()
end

function world:save()
	local objs = {}
	local ids = {}
	for id, obj in pairs(self.objects) do
		if obj.state == "resident" then obj:sync_state() end
		ids[#ids + 1] = id
	end
	table.sort(ids)
	for i, id in ipairs(ids) do objs[i] = self.objects[id]:serialize() end
	return {
		version = world.SAVE_VERSION,
		time = self.time,
		tick = self.tick,
		next_id = self.next_id,
		focus = self.focus_id,
		camera = self.camera and self.camera.id,
		player = self.player and self.player.id,
		objects = objs,
	}
end

function world:load(state)
	if state.version ~= world.SAVE_VERSION then error("unsupported save version " .. tostring(state.version)) end
	self:clear()
	self.time = state.time or 0
	self.tick = state.tick or 0
	for _, s in ipairs(state.objects) do
		local class = object.class(s.type)
		self:add(class.create(class, self, s))
	end
	self.next_id = max(self.next_id, state.next_id or 1)
	for _, obj in pairs(self.objects) do obj:link() end
	self.camera = self.objects[state.camera]
	self.player = self.objects[state.player]
	self:set_focus(state.focus)
	self:stream(true)
end

function world:save_file(path)
	return serialize.write_file(path or self.config.save_path, self:save())
end

function world:load_file(path)
	local state, err = serialize.read_file(path or self.config.save_path)
	if not state then return nil, err end
	self:load(state)
	return true
end

function world:link_all()
	for _, obj in pairs(self.objects) do obj:link() end
end

function world:draw(target, view, alpha)
	self.scene:draw(target, view, self.lights, alpha)
end

function world:shutdown()
	self.assets:shutdown()
end

return world
local util = require("game.util")

local prefabs = {defs = {}, resolved = {}}

function prefabs.define(kind, name, data)
	local by_kind = prefabs.defs[kind]
	if not by_kind then
		by_kind = {}
		prefabs.defs[kind] = by_kind
	end
	by_kind[name] = data
	prefabs.resolved[kind .. "/" .. name] = nil
end

local function resolve(kind, name, trail)
	local id = kind .. "/" .. name
	local cached = prefabs.resolved[id]
	if cached then return cached end
	local def = prefabs.defs[kind] and prefabs.defs[kind][name]
	if not def then error("unknown " .. kind .. " prefab '" .. tostring(name) .. "'", 3) end
	if trail[id] then error("prefab extends cycle at " .. id, 3) end
	trail[id] = true
	local out
	if def.extends then
		out = util.deep_copy(resolve(kind, def.extends, trail))
		local own = util.deep_copy(def)
		own.extends = nil
		util.merge(out, own)
	else
		out = util.deep_copy(def)
	end
	trail[id] = nil
	prefabs.resolved[id] = out
	return out
end

function prefabs.get(kind, name, overrides)
	local base = resolve(kind, name, {})
	if overrides and next(overrides) then
		return util.merge(util.deep_copy(base), overrides)
	end
	return base
end

function prefabs.exists(kind, name)
	return prefabs.defs[kind] ~= nil and prefabs.defs[kind][name] ~= nil
end

function prefabs.names(kind)
	local out = {}
	for name in pairs(prefabs.defs[kind] or {}) do out[#out + 1] = name end
	table.sort(out)
	return out
end

local data_modules = {"game.data.cameras", "game.data.world_objects", "game.data.players", "game.data.suspensions", "game.data.tires", "game.data.vehicles"}

function prefabs.load_all(extra)
	for _, name in ipairs(data_modules) do require(name) end
	for _, name in ipairs(extra or {}) do require(name) end
end

return prefabs
local input = {}
input.__index = input

input.keys = {
	a = 4, b = 5, c = 6, d = 7, e = 8, f = 9, g = 10, h = 11, i = 12, j = 13, k = 14, l = 15, m = 16,
	n = 17, o = 18, p = 19, q = 20, r = 21, s = 22, t = 23, u = 24, v = 25, w = 26, x = 27, y = 28, z = 29,
	enter = 40, escape = 41, backspace = 42, tab = 43, space = 44,
	f1 = 58, f2 = 59, f3 = 60, f4 = 61, f5 = 62, f6 = 63, f7 = 64, f8 = 65, f9 = 66, f10 = 67, f11 = 68, f12 = 69,
	right = 79, left = 80, down = 81, up = 82,
	lshift = 225, rshift = 229, lctrl = 224,
}

input.default_bindings = {
	forward = {"w"},
	backward = {"s"},
	left = {"a"},
	right = {"d"},
	jump = {"space"},
	interact = {"f"},
	handbrake = {"lshift", "rshift"},
	reset_vehicle = {"r"},
	look_left = {"left"},
	look_right = {"right"},
	look_up = {"up"},
	look_down = {"down"},
	quick_save = {"f5"},
	quick_load = {"f9"},
	toggle_debug = {"f1"},
}

function input.new(bindings)
	local self = setmetatable({}, input)
	self.down = {}
	self.pressed = {}
	self.mouse_dx = 0
	self.mouse_dy = 0
	self.action_codes = {}
	self:set_bindings(bindings or input.default_bindings)
	return self
end

function input:set_bindings(bindings)
	self.action_codes = {}
	for action, names in pairs(bindings) do
		local codes = {}
		for i, name in ipairs(names) do codes[i] = input.keys[name] or name end
		self.action_codes[action] = codes
	end
end

function input:event(e)
	if e.type == "key" then
		if e.down then
			if not self.down[e.key] then self.pressed[e.key] = true end
			self.down[e.key] = true
		else
			self.down[e.key] = nil
		end
	elseif e.type == "mouse_move" then
		self.mouse_dx = self.mouse_dx + (e.dx or 0)
		self.mouse_dy = self.mouse_dy + (e.dy or 0)
	end
end

function input:held(action)
	local codes = self.action_codes[action]
	if not codes then return false end
	local down = self.down
	for i = 1, #codes do
		if down[codes[i]] then return true end
	end
	return false
end

function input:hit(action)
	local codes = self.action_codes[action]
	if not codes then return false end
	local pressed = self.pressed
	for i = 1, #codes do
		if pressed[codes[i]] then return true end
	end
	return false
end

function input:axis(negative, positive)
	local v = 0
	if self:held(positive) then v = v + 1 end
	if self:held(negative) then v = v - 1 end
	return v
end

function input:end_tick()
	if next(self.pressed) then self.pressed = {} end
	self.mouse_dx = 0
	self.mouse_dy = 0
end

return input
local serialize = require("game.serialize")
local worker = require("game.asset_worker")

local assets = {}
assets.__index = assets

local clock = os.clock
local key_cache = setmetatable({}, {__mode = "k"})

function assets.model_gen(name, ...)
	return {kind = "model", gen = name, args = {...}}
end

function assets.model_file(path)
	return {kind = "model", path = path}
end

function assets.texture_gen(name, args)
	return {kind = "texture", gen = name, args = args or {}}
end

function assets.texture_file(path, max_size)
	return {kind = "texture", path = path, max_size = max_size}
end

function assets.spec_key(spec)
	local key = key_cache[spec]
	if not key then
		key = serialize.to_string(spec)
		key_cache[spec] = key
	end
	return key
end

local function remote_build(spec)
	return require("game.asset_worker").build(spec)
end

function assets.new(config)
	local self = setmetatable({}, assets)
	self.config = config
	self.entries = {}
	self.pending = {}
	self.pending_count = 0
	self.in_flight = {}
	self.in_flight_count = 0
	self.idle = {}
	self.composites = {}
	self.idle_bytes = 0
	self.live_bytes = 0
	self.next_dispatch = 0
	self.last_sweep = 0
	self.now = 0
	self.stats_table = {requested = 0, built_background = 0, built_sync = 0, evicted = 0, failed = 0, hits = 0}
	return self
end

function assets:start_worker()
	if self.thread then return end
	self.thread = thread.create({paused = false, priority = self.config.worker_priority or 0})
end

function assets:acquire_textured(model_spec, texture_spec)
	local key = "T|" .. assets.spec_key(model_spec) .. "|" .. assets.spec_key(texture_spec)
	local entry = self.entries[key]
	if not entry then
		entry = {key = key, state = "waiting", refs = 0, priority = math.huge, bytes = 0, composite = true}
		entry.model_entry = self:acquire(model_spec)
		entry.texture_entry = self:acquire(texture_spec)
		self.entries[key] = entry
		self.composites[#self.composites + 1] = entry
		self.stats_table.requested = self.stats_table.requested + 1
	else
		self.stats_table.hits = self.stats_table.hits + 1
	end
	if entry.refs == 0 and entry.idle_since then
		entry.idle_since = nil
		self.idle[key] = nil
		self.idle_bytes = self.idle_bytes - entry.bytes
	end
	entry.refs = entry.refs + 1
	return entry
end

function assets:acquire(spec)
	local key = assets.spec_key(spec)
	local entry = self.entries[key]
	if not entry then
		entry = {key = key, spec = spec, state = "pending", refs = 0, priority = math.huge, bytes = 0, pending_index = nil}
		self.entries[key] = entry
		self.stats_table.requested = self.stats_table.requested + 1
	else
		self.stats_table.hits = self.stats_table.hits + 1
	end
	if entry.refs == 0 and entry.idle_since then
		entry.idle_since = nil
		self.idle[key] = nil
		self.idle_bytes = self.idle_bytes - entry.bytes
	end
	entry.refs = entry.refs + 1
	if entry.state == "pending" and not entry.pending_index then
		self.pending_count = self.pending_count + 1
		self.pending[self.pending_count] = entry
		entry.pending_index = self.pending_count
	end
	return entry
end

local function remove_pending(self, entry)
	local index = entry.pending_index
	if not index then return end
	local last = self.pending[self.pending_count]
	self.pending[index] = last
	last.pending_index = index
	self.pending[self.pending_count] = nil
	self.pending_count = self.pending_count - 1
	entry.pending_index = nil
end

local function drop_composite(self, entry)
	for i = 1, #self.composites do
		if self.composites[i] == entry then
			self.composites[i] = self.composites[#self.composites]
			self.composites[#self.composites] = nil
			break
		end
	end
	if entry.model_entry then
		self:release(entry.model_entry)
		self:release(entry.texture_entry)
		entry.model_entry, entry.texture_entry = nil, nil
	end
end

function assets:release(entry)
	entry.refs = entry.refs - 1
	if entry.refs > 0 then return end
	if entry.state == "waiting" then
		drop_composite(self, entry)
		self.entries[entry.key] = nil
		return
	end
	if entry.state == "pending" then
		remove_pending(self, entry)
		self.entries[entry.key] = nil
		return
	end
	if entry.state == "failed" then
		self.entries[entry.key] = nil
		return
	end
	entry.idle_since = self.now
	self.idle[entry.key] = entry
	self.idle_bytes = self.idle_bytes + entry.bytes
end

function assets:prioritize(entry, priority)
	if priority < entry.priority then entry.priority = priority end
	if entry.model_entry then
		self:prioritize(entry.model_entry, priority)
		self:prioritize(entry.texture_entry, priority)
	end
end

function assets.is_ready(entry)
	return entry.state == "ready"
end

local function finish_entry(self, entry, handle, bounds, bytes)
	entry.handle = handle
	entry.bounds = bounds
	entry.bytes = bytes
	entry.state = "ready"
	self.live_bytes = self.live_bytes + bytes
end

local function fail_entry(self, entry, err)
	entry.state = "failed"
	entry.error = err
	self.stats_table.failed = self.stats_table.failed + 1
	io.stderr:write("asset failed: ", entry.key, ": ", tostring(err), "\n")
end

local function build_composite(self, entry)
	local m, t = entry.model_entry, entry.texture_entry
	if m.state == "failed" or t.state == "failed" then
		drop_composite(self, entry)
		fail_entry(self, entry, "dependency failed")
		return
	end
	local copy = m.handle:copy()
	copy:set_texture(t.handle)
	local bytes = m.bytes
	local bounds = m.bounds
	drop_composite(self, entry)
	finish_entry(self, entry, copy, bounds, bytes)
	self.stats_table.composed = (self.stats_table.composed or 0) + 1
end

function assets:ensure_now(entry)
	if entry.state == "ready" or entry.state == "failed" then return entry.state == "ready" end
	if entry.state == "waiting" then
		self:ensure_now(entry.model_entry)
		self:ensure_now(entry.texture_entry)
		build_composite(self, entry)
		return entry.state == "ready"
	end
	if entry.state == "loading" then
		local task = entry.task
		local ok, handle, bounds, bytes, elapsed = task:finish()
		self.in_flight[entry.key] = nil
		self.in_flight_count = self.in_flight_count - 1
		entry.task = nil
		if ok then
			finish_entry(self, entry, handle, bounds, bytes)
			self.stats_table.built_background = self.stats_table.built_background + 1
		else
			fail_entry(self, entry, handle)
		end
		return entry.state == "ready"
	end
	remove_pending(self, entry)
	local ok, handle, bounds, bytes = pcall(worker.build, entry.spec)
	if ok then
		finish_entry(self, entry, handle, bounds, bytes)
		self.stats_table.built_sync = self.stats_table.built_sync + 1
	else
		fail_entry(self, entry, handle)
	end
	return entry.state == "ready"
end

local function dispatch_next(self, now_ms)
	if self.pending_count == 0 then return end
	local best, best_priority = nil, math.huge
	local pending = self.pending
	for i = 1, self.pending_count do
		local e = pending[i]
		if e.priority <= best_priority then
			best, best_priority = e, e.priority
		end
	end
	if not best then return end
	remove_pending(self, best)
	self:start_worker()
	best.state = "loading"
	best.task = self.thread:dispatch(remote_build, {best.spec})
	self.in_flight[best.key] = best
	self.in_flight_count = self.in_flight_count + 1
end

local function evict(self, entry)
	self.idle[entry.key] = nil
	self.entries[entry.key] = nil
	self.idle_bytes = self.idle_bytes - entry.bytes
	self.live_bytes = self.live_bytes - entry.bytes
	entry.handle = nil
	entry.state = "evicted"
	self.stats_table.evicted = self.stats_table.evicted + 1
end

function assets:sweep(now)
	local cfg = self.config
	local evicted = 0
	local ttl = cfg.cache_idle_ttl
	for _, entry in pairs(self.idle) do
		if now - entry.idle_since > ttl then
			evict(self, entry)
			evicted = evicted + 1
		end
	end
	if self.idle_bytes > cfg.cache_idle_bytes then
		local list = {}
		for _, entry in pairs(self.idle) do list[#list + 1] = entry end
		table.sort(list, function(a, b) return a.idle_since < b.idle_since end)
		for i = 1, #list do
			if self.idle_bytes <= cfg.cache_idle_bytes then break end
			evict(self, list[i])
			evicted = evicted + 1
		end
	end
	if evicted > 0 then collectgarbage("step", cfg.gc_step or 2) end
end

function assets:update(now)
	self.now = now
	local now_ms = thread.time()
	if self.in_flight_count > 0 then
		for key, entry in pairs(self.in_flight) do
			local ok, handle, bounds, bytes, elapsed = entry.task:poll()
			if ok ~= nil then
				self.in_flight[key] = nil
				self.in_flight_count = self.in_flight_count - 1
				entry.task = nil
				if ok then
					finish_entry(self, entry, handle, bounds, bytes)
					self.stats_table.built_background = self.stats_table.built_background + 1
					local percent = self.config.worker_percent
					if percent > 0 and percent < 1 then
						local wait = (elapsed or 0) * (1 - percent) / percent
						local due = now_ms + wait
						if due > self.next_dispatch then self.next_dispatch = due end
					end
				else
					fail_entry(self, entry, handle)
				end
			end
		end
	end
	local comps = self.composites
	local ci = 1
	while ci <= #comps do
		local e = comps[ci]
		local m, t = e.model_entry, e.texture_entry
		if (m.state == "ready" or m.state == "failed") and (t.state == "ready" or t.state == "failed") then
			build_composite(self, e)
		else
			ci = ci + 1
		end
	end
	if self.pending_count > 0 and self.in_flight_count < self.config.max_in_flight and now_ms >= self.next_dispatch then
		dispatch_next(self, now_ms)
	end
	if now - self.last_sweep > 1 then
		self.last_sweep = now
		self:sweep(now)
	end
end

function assets:idle_wait()
	return self.pending_count + self.in_flight_count + #self.composites
end

function assets:flush(timeout_ms)
	local limit = thread.time() + (timeout_ms or 10000)
	self.next_dispatch = 0
	while self:idle_wait() > 0 and thread.time() < limit do
		self.next_dispatch = 0
		self:update(self.now)
		thread.sleep(1)
	end
end

function assets:stats()
	local s = self.stats_table
	return {composed = s.composed or 0, waiting = #self.composites, pending = self.pending_count, in_flight = self.in_flight_count, live_bytes = self.live_bytes, idle_bytes = self.idle_bytes, requested = s.requested, hits = s.hits, built_background = s.built_background, built_sync = s.built_sync, evicted = s.evicted, failed = s.failed}
end

function assets:shutdown()
	if self.thread then
		self.thread:stop()
		self.thread = nil
	end
end

return assets
local prefabs = require("game.prefabs")
local visual = require("game.visual")
local util = require("game.util")

local object = {types = {}}

local base = {}
base.__index = base
base.type = "object"
base.dynamic = false
base.child = false
base.collides = false

function object.extend(type_name, parent)
	parent = parent or base
	local class = setmetatable({}, {__index = parent})
	class.__index = class
	class.type = type_name
	class.super = parent
	object.types[type_name] = class
	return class
end

function object.class(type_name)
	local class = object.types[type_name]
	if not class then error("unknown object type '" .. tostring(type_name) .. "'", 2) end
	return class
end

function base.create(class, world, init)
	local self = setmetatable({}, class)
	self.world = world
	self.id = init.id
	self.prefab_name = init.prefab
	self.overrides = init.overrides
	self.prefab = prefabs.get(class.type, init.prefab, init.overrides)
	local p = init.pos
	self.pos = {p and p[1] or 0, p and p[2] or 0, p and p[3] or 0}
	self.yaw = init.yaw or 0
	self.state = "idle"
	self.speed_value = 0
	if class.init then class.init(self, init) end
	return self
end

function base:serialize()
	return {
		type = self.type,
		id = self.id,
		prefab = self.prefab_name,
		overrides = self.overrides,
		pos = {self.pos[1], self.pos[2], self.pos[3]},
		yaw = self.yaw,
	}
end

function base:position()
	local p = self.pos
	return p[1], p[2], p[3]
end

function base:speed()
	return self.speed_value
end

function base:radius()
	return self.prefab.radius or 1
end

function base:stream_radii(cfg)
	local critical = self.prefab.critical_radius or (self:radius() + cfg.critical_margin)
	local load = self.prefab.load_radius or math.max(cfg.load_radius, critical * 1.5)
	if load < critical then load = critical end
	local unload = self.prefab.unload_radius or load * cfg.unload_hysteresis
	return critical, load, unload
end

function base:is_pinned()
	return self.prefab.pinned == true
end

function base:asset_parts()
	return self.prefab.parts or {}
end

function base:acquire_assets()
	if self.entries then return end
	self.parts = self:asset_parts()
	self.entries = visual.acquire(self.world.assets, self.parts)
end

function base:release_assets()
	if not self.entries then return end
	visual.release(self.world.assets, self.entries)
	self.entries = nil
	self.parts = nil
end

function base:assets_ready()
	return self.entries ~= nil and visual.ready(self.entries)
end

function base:ensure_assets_now()
	self:acquire_assets()
	visual.ensure_now(self.world.assets, self.entries)
end

function base:prioritize_assets(priority)
	if self.entries then visual.prioritize(self.world.assets, self.entries, priority) end
end

function base:on_load() end
function base:on_unload() end
function base:sync_state() end
function base:link() end
function base:on_added() end
function base:on_removed() end

return object
local world_module = require("game.world")
local demo = require("game.content.demo")
local config = require("game.config")

local game = {tick_rate = config.tick_rate, max_catchup = 4}
game.__index = game

local color = texture.color
local clock = os.clock

local function make_sky(width, height)
	local list = texture.list()
	list:add_gradient(color(70, 120, 200), color(170, 210, 240), {dir = "vertical", dither = true, rect = {1, 1, width, height // 2}})
	list:add_gradient(color(170, 210, 240), color(110, 150, 120), {dir = "vertical", dither = true, rect = {1, height // 2 + 1, width, height}})
	return list
end

function game.new(target, opts)
	local self = setmetatable({}, game)
	opts = opts or {}
	self.target = target
	self.width, self.height = target:width(), target:height()
	self.sky = make_sky(self.width, self.height)
	self.world = world_module.new(opts.world)
	self.world.lights:set_sun({-0.4, -1, -0.3}, color(255, 250, 235), color(70, 80, 110))
	self.world.lights:set_ambient(color(60, 66, 90))
	demo.build(self.world, opts.demo)
	self.world:stream(true)
	self.fps = 0
	self.smooth_dt = nil
	self.show_debug = true
	self.message = nil
	self.message_until = 0
	screen.capture_mouse(true)
	return self
end

function game:notify(text)
	self.message = text
	self.message_until = self.world.time + 2.5
end

function game:on_event(e)
	self.world.input:event(e)
end

function game:update(dt)
	local w = self.world
	local input = w.input
	if input:hit("quick_save") then
		local ok, err = w:save_file()
		self:notify(ok and "saved" or ("save failed: " .. tostring(err)))
	elseif input:hit("quick_load") then
		local ok, err = w:load_file()
		self:notify(ok and "loaded" or ("load failed: " .. tostring(err)))
	end
	if input:hit("toggle_debug") then self.show_debug = not self.show_debug end
	w:update(dt)
end

local function text(target, x, y, str, c)
	target:draw_text(x + 1, y + 1, str, 0xF000, 1)
	target:draw_text(x, y, str, c or 0xFFFF, 1)
end

function game:draw(alpha, frame_dt)
	local w = self.world
	local target = self.target
	frame_dt = frame_dt or 1 / 60
	w.frame_dt = frame_dt
	if frame_dt > 0 then
		local k = 1 - math.exp(-frame_dt / 0.5)
		self.smooth_dt = self.smooth_dt and (self.smooth_dt + (frame_dt - self.smooth_dt) * k) or frame_dt
	end
	self.sky:draw(target)
	render.clear_depth(target)
	local cam = w.camera
	if cam and cam.instance then w:draw(target, cam.view, alpha) end

	local player = w.player
	if self.show_debug then
		local s = w.assets:stats()
		local fps = self.smooth_dt and math.floor(1 / self.smooth_dt + 0.5) or 0
		text(target, 4, 4, string.format("FPS %d  TICK %.2fms", fps, w.stats.budget_used_ms))
		text(target, 4, 14, string.format("OBJ %d RES %d LOAD %d CRIT %d", w.stats.objects, w.stats.resident, w.stats.loading, w.stats.critical_loads))
		text(target, 4, 24, string.format("ASSET Q%d F%d  %.1fMB  bg %d sync %d hit %d", s.pending, s.in_flight, (s.live_bytes) / 1048576, s.built_background, s.built_sync, s.hits))
	end
	if player then
		if player.vehicle_id then
			local v = w.objects[player.vehicle_id]
			if v then text(target, self.width // 2 - 40, self.height - 14, string.format("%3d km/h", math.floor(v.speed_value * 3.6 + 0.5)), 0xFFF8) end
		end
		if player.prompt then text(target, self.width // 2 - #player.prompt * 4, self.height - 28, player.prompt, 0xFFF0) end
	end
	if self.show_debug then
		text(target, 4, 34, "WASD move  SPACE jump  F enter/exit  SHIFT handbrake  R right car  F5/F9 save/load", 0xFCCC)
	end
	if self.message and w.time < self.message_until then
		text(target, self.width // 2 - #self.message * 4, 40, self.message, 0xF8F8)
	end
end

return game
local object = require("game.object")
local visual = require("game.visual")

local world_object = object.extend("world_object")
world_object.collides = true

function world_object:init(init)
	local s = init.scale
	if type(s) == "number" then s = {s, s, s} end
	self.scale = s and {s[1], s[2], s[3]} or nil
	self.scale_factor = s and math.max(s[1], s[2], s[3]) or 1
	self.collide = init.collide
end

function world_object:serialize()
	local t = object.types.world_object.super.serialize(self)
	t.scale = self.scale
	t.collide = self.collide
	return t
end

function world_object:radius()
	return (self.prefab.radius or 1) * self.scale_factor
end

function world_object:has_collision()
	local collide = self.collide
	if collide == nil then collide = self.prefab.collide ~= false end
	return collide
end

function world_object:on_load()
	local pose = {px = self.pos[1], py = self.pos[2], pz = self.pos[3]}
	pose.xx, pose.xy, pose.xz, pose.yx, pose.yy, pose.yz, pose.zx, pose.zy, pose.zz = visual.yaw_basis(self.yaw)
	local collide = self:has_collision()
	self.ids = visual.create(self.world.scene, self.parts, self.entries, pose, self.scale, collide)
	self.has_colliders = collide
end

function world_object:on_unload()
	if self.ids then
		visual.destroy(self.world.scene, self.ids)
		self.ids = nil
	end
end

return world_object
local object = require("game.object")
local util = require("game.util")

local suspension = object.extend("suspension")
suspension.child = true

local clamp = util.clamp

local REBOUND = 1.6
local STOP_ZONE = 0.25
local STOP_STIFFNESS = 20
local BLOW_OFF = 6

function suspension:init(init)
	self.owner_id = init.owner_id
	self.wheel_index = init.wheel_index
	self.compression = init.compression or 0
	self.grounded = false
	self.rate = 0
	self.force = 0
	self.contact_x, self.contact_y, self.contact_z = 0, 0, 0
	self.normal_x, self.normal_y, self.normal_z = 0, 1, 0
	self.hit_body = nil
	self.load = 0
	self.spring, self.bump, self.rebound, self.bar = 0, 0, 0, 0
end

function suspension:serialize()
	local t = object.types.suspension.super.serialize(self)
	t.owner_id = self.owner_id
	t.wheel_index = self.wheel_index
	t.compression = self.compression
	return t
end

function suspension:tune(corner_mass)
	local p = self.prefab
	local omega = 2 * math.pi * p.frequency
	local k = corner_mass * omega * omega
	local critical = 2 * math.sqrt(k * corner_mass)
	self.spring = k
	self.bump = p.damping * critical
	self.rebound = p.damping * critical * REBOUND
	self.bar = p.anti_roll * k
	self.sag = 9.81 / (omega * omega)
end

function suspension:read_wheel(compression, rate, contact)
	self.compression = compression
	self.rate = rate
	if contact then
		self.grounded = true
		local n, pt = contact.normal, contact.point
		self.contact_point = pt
		self.contact_x, self.contact_y, self.contact_z = pt[1], pt[2], pt[3]
		self.normal_x, self.normal_y, self.normal_z = n[1], n[2], n[3]
		self.hit_body = contact.body
		self.load = contact.load
	else
		self.grounded = false
		self.hit_body = nil
		self.load = 0
	end
end

function suspension:solve()
	local p = self.prefab
	local c = self.compression
	local f = self.spring * c
	local stop = p.travel * (1 - STOP_ZONE)
	if c > stop then
		local x = c - stop
		f = f + STOP_STIFFNESS * self.spring * x
	end
	local rate = clamp(self.rate, -BLOW_OFF, BLOW_OFF)
	f = f + (rate > 0 and self.bump or self.rebound) * rate
	if f < 0 then f = 0 end
	self.force = f
	return f
end

return suspension
local object = require("game.object")
local world_object = require("game.objects.world_object")
local visual = require("game.visual")

local prop = object.extend("prop", world_object)
prop.dynamic = true
prop.collides = false

local function copy3(v, default)
	v = v or default
	return {v[1], v[2], v[3]}
end

function prop:init(init)
	self.scale, self.scale_factor = nil, 1
	self.collide = nil
	self.rot = init.rot and {init.rot[1], init.rot[2], init.rot[3], init.rot[4]}
	if not self.rot then
		local half = self.yaw / 2
		self.rot = {0, math.sin(half), 0, math.cos(half)}
		self.pos[2] = self.pos[2] + self.prefab.body.size[2] * 0.5
	end
	self.vel = copy3(init.vel, {0, 0, 0})
	self.ang = copy3(init.ang, {0, 0, 0})
	self.body = nil
	self.ids = nil
	self.awake = true
end

function prop:serialize()
	self:sync_state()
	local t = object.types.world_object.super.serialize(self)
	t.rot = {self.rot[1], self.rot[2], self.rot[3], self.rot[4]}
	t.vel = {self.vel[1], self.vel[2], self.vel[3]}
	t.ang = {self.ang[1], self.ang[2], self.ang[3]}
	return t
end

function prop:radius()
	return self.prefab.radius or 1
end

function prop:is_pinned()
	return false
end

function prop:on_load()
	local b = self.prefab.body
	local body = self.world.phys:add_body{
		shape = b.shape or "box",
		size = b.size,
		radius = b.radius,
		height = b.height,
		mass = b.mass,
		pos = {self.pos[1], self.pos[2], self.pos[3]},
		rotation = {self.rot[1], self.rot[2], self.rot[3], self.rot[4]},
		velocity = {self.vel[1], self.vel[2], self.vel[3]},
		angular_velocity = {self.ang[1], self.ang[2], self.ang[3]},
		friction = b.friction,
		bounciness = b.bounciness,
		drag = b.drag,
		rotational_drag = b.rotational_drag,
	}
	self.body = body
	self.awake = true
	self.basis = {}
	self.ids = visual.create(self.world.scene, self.parts, self.entries, self:read_basis(), nil, false)
	visual.snap(self.world.scene, self.ids)
end

function prop:read_basis()
	local body = self.body
	local p = body:position()
	local x, y, z = body:axes()
	local b = self.basis
	b.px, b.py, b.pz = p[1], p[2], p[3]
	b.xx, b.xy, b.xz = x[1], x[2], x[3]
	b.yx, b.yy, b.yz = y[1], y[2], y[3]
	b.zx, b.zy, b.zz = z[1], z[2], z[3]
	self.pos[1], self.pos[2], self.pos[3] = p[1], p[2], p[3]
	return b
end

function prop:sync_state()
	local body = self.body
	if not body then return end
	local r = body:rotation()
	self.rot[1], self.rot[2], self.rot[3], self.rot[4] = r[1], r[2], r[3], r[4]
	local v = body:velocity()
	self.vel[1], self.vel[2], self.vel[3] = v[1], v[2], v[3]
	local a = body:angular_velocity()
	self.ang[1], self.ang[2], self.ang[3] = a[1], a[2], a[3]
	local p = body:position()
	self.pos[1], self.pos[2], self.pos[3] = p[1], p[2], p[3]
end

function prop:on_unload()
	self:sync_state()
	if self.body then
		self.body:remove()
		self.body = nil
	end
	if self.ids then
		visual.destroy(self.world.scene, self.ids)
		self.ids = nil
	end
end

function prop:post_update(dt)
	local body = self.body
	if not body then return end
	local awake = body:awake()
	if not awake and not self.awake then return end
	self.awake = awake
	local b = self:read_basis()
	local v = body:velocity()
	self.speed_value = math.sqrt(v[1] * v[1] + v[2] * v[2] + v[3] * v[3])
	visual.pose(self.world.scene, self.ids, self.parts, 1, #self.parts, b.px, b.py, b.pz, b.xx, b.xy, b.xz, b.yx, b.yy, b.yz, b.zx, b.zy, b.zz)
end

return prop
local object = require("game.object")

local tire = object.extend("tire")
tire.child = true

local abs, sqrt, max, min = math.abs, math.sqrt, math.max, math.min

local KINETIC = 0.88
local MIN_SLIP_SPEED = 1.0
local ROLLING = 0.012
local LOCK_RATE = 1.0
local INERTIA_SHAPE = 0.7

function tire:init(init)
	self.owner_id = init.owner_id
	self.wheel_index = init.wheel_index
	self.omega = init.omega or 0
	self.spin = init.spin or 0
	self.lateral_slip = 0
	self.fx, self.fy = 0, 0
	self.slip_ratio = 0
	self.slip_angle = 0
	self.sliding = false
	self.load = 0
	self.slip_norm = 0
	self.slide_speed = 0
	self.contact_ok = false
	self.cx, self.cy, self.cz = 0, 0, 0
	self.emit_acc = 0
end

function tire:serialize()
	local t = object.types.tire.super.serialize(self)
	t.owner_id = self.owner_id
	t.wheel_index = self.wheel_index
	t.omega = self.omega
	t.spin = self.spin
	return t
end

local function brush(theta)
	if theta < 1 then
		return theta * (3 - theta * (3 - theta))
	end
	local t = (theta - 1) / 1.5
	if t > 1 then t = 1 end
	return 1 - (1 - KINETIC) * t
end

local function sat(x)
	if x > 1 then return 1 elseif x < -1 then return -1 end
	return x
end

function tire:inertia()
	local p = self.prefab
	return INERTIA_SHAPE * p.mass * p.radius * p.radius
end

local function longitudinal(p, fz, sy, vf, vr, omega)
	local denom = sqrt(vf * vf + vr * vr)
	if denom < MIN_SLIP_SPEED then denom = MIN_SLIP_SPEED end
	local sx = (omega * p.radius - vf) / denom
	local s = sqrt(sx * sx + sy * sy)
	if s < 1e-9 then return 0, 0, 0, 0 end
	local theta = p.stiffness * s / (3 * p.grip)
	local mag = p.grip * fz * brush(theta)
	return mag * sx / s, -mag * sy / s, theta, sx
end

function tire:solve(h, grounded, fz, vf, vr, torque, brake)
	local p = self.prefab
	local r = p.radius
	local inertia = self:inertia()
	local omega = self.omega
	local fx, fy = 0, 0
	local rolling = 0
	if grounded and fz > 0 then
		rolling = ROLLING * fz * r
		local denom = sqrt(vf * vf + vr * vr)
		if denom < MIN_SLIP_SPEED then denom = MIN_SLIP_SPEED end
		local raw = vr / denom
		local relax = 1.2 * r
		local k = denom * h / relax
		if k > 1 then k = 1 end
		self.lateral_slip = self.lateral_slip + (raw - self.lateral_slip) * k
		local sy = self.lateral_slip
		local w = omega
		local function residual(x)
			local f = longitudinal(p, fz, sy, vf, vr, x)
			return inertia * (x - omega) / h - torque + f * r + (brake * sat(x / LOCK_RATE)) + rolling * sat(x / LOCK_RATE)
		end
		w = omega + (torque - brake * sat(omega / LOCK_RATE)) / inertia * h
		for _ = 1, 4 do
			local f0 = residual(w)
			local d = 0.05
			local slope = (residual(w + d) - f0) / d
			local floor = 0.1 * inertia / h
			if slope < floor then slope = floor end
			w = w - f0 / slope
		end
		omega = w
		local theta, sx
		fx, fy, theta, sx = longitudinal(p, fz, sy, vf, vr, omega)
		theta = theta or 0
		self.slip_ratio = sx or 0
		self.slip_angle = sy
		self.sliding = theta > 1
		self.slip_norm = theta > 2 and 2 or theta
		local sl = omega * r - vf
		self.slide_speed = sqrt(sl * sl + vr * vr)
		self.contact_ok = true
	else
		local t = torque - brake * sat(omega / LOCK_RATE)
		omega = omega + t / inertia * h
		self.lateral_slip = 0
		self.slip_ratio, self.slip_angle = 0, 0
		self.sliding = false
		self.slip_norm = 0
		self.slide_speed = 0
		self.contact_ok = false
	end
	self.omega = omega
	self.spin = (self.spin + omega * h) % (2 * math.pi)
	self.fx, self.fy = fx, fy
	self.load = fz
	return fx, fy
end

return tire
local object = require("game.object")
local visual = require("game.visual")
local util = require("game.util")

local vehicle = object.extend("vehicle")
vehicle.dynamic = true
vehicle.collides = false

local sin, cos, sqrt, atan2, abs = math.sin, math.cos, math.sqrt, math.atan, math.abs
local min, max = math.min, math.max
local clamp = util.clamp

local G = 9.81
local AIR_DENSITY = 1.2
local PEDAL_RATE = 6
local BRAKE_RATE = 10
local REVERSE_SPEED = 10
local REVERSE_TORQUE = 0.5

local function quat_from_yaw(yaw)
	return {0, sin(yaw / 2), 0, cos(yaw / 2)}
end

function vehicle:init(init)
	self.rot = init.rot and {init.rot[1], init.rot[2], init.rot[3], init.rot[4]} or quat_from_yaw(self.yaw)
	self.vel = init.vel and {init.vel[1], init.vel[2], init.vel[3]} or {0, 0, 0}
	self.ang = init.ang and {init.ang[1], init.ang[2], init.ang[3]} or {0, 0, 0}
	self.driver_id = init.driver_id
	self.suspension_ids = init.suspension_ids
	self.tire_ids = init.tire_ids
	self.steer = init.steer or 0
	self.controls = {throttle = 0, steer = 0, handbrake = 0}
	self.pedal = {throttle = 0, handbrake = 0}
	self.body = nil
	self.ids = nil
	self.wheel_count = #self.prefab.wheels
	self.forward_speed = 0
end

function vehicle:serialize()
	local t = object.types.vehicle.super.serialize(self)
	t.rot = {self.rot[1], self.rot[2], self.rot[3], self.rot[4]}
	t.vel = {self.vel[1], self.vel[2], self.vel[3]}
	t.ang = {self.ang[1], self.ang[2], self.ang[3]}
	t.driver_id = self.driver_id
	t.suspension_ids = self.suspension_ids
	t.tire_ids = self.tire_ids
	t.steer = self.steer
	return t
end

function vehicle:on_added()
	if self.suspension_ids then return end
	local world = self.world
	self.suspension_ids, self.tire_ids = {}, {}
	for i, w in ipairs(self.prefab.wheels) do
		local s = world:spawn("suspension", w.suspension, {overrides = w.suspension_overrides, owner_id = self.id, wheel_index = i})
		local t = world:spawn("tire", w.tire, {overrides = w.tire_overrides, owner_id = self.id, wheel_index = i})
		self.suspension_ids[i] = s.id
		self.tire_ids[i] = t.id
	end
	self:link()
end

function vehicle:reach()
	return self.prefab.radius or 3
end

function vehicle:on_removed()
	local world = self.world
	for i = 1, #(self.suspension_ids or {}) do
		world:remove(self.suspension_ids[i])
		world:remove(self.tire_ids[i])
	end
end

function vehicle:link()
	local world = self.world
	self.suspensions, self.tires = {}, {}
	for i = 1, self.wheel_count do
		self.suspensions[i] = world.objects[self.suspension_ids[i]]
		self.tires[i] = world.objects[self.tire_ids[i]]
	end
	local d, b, h = 0, 0, 0
	for _, w in ipairs(self.prefab.wheels) do
		d, b, h = d + w.drive, b + w.brake, h + w.handbrake
	end
	self.drive_total, self.brake_total, self.hand_total = d, b, h
end

function vehicle:radius()
	return self.prefab.radius or 3
end

function vehicle:is_pinned()
	return self.driver_id ~= nil or self.id == self.world.focus_id
end

function vehicle:asset_parts()
	local parts = {}
	for i, part in ipairs(self.prefab.parts) do parts[i] = part end
	self.chassis_part_count = #parts
	for i, w in ipairs(self.prefab.wheels) do
		parts[#parts + 1] = self.tires[i].prefab.part
	end
	return parts
end

function vehicle:on_load()
	local world = self.world
	local c = self.prefab.chassis
	self.body = world.phys:add_body{
		shape = "box",
		size = c.size,
		mass = c.mass,
		pos = {self.pos[1], self.pos[2], self.pos[3]},
		rotation = {self.rot[1], self.rot[2], self.rot[3], self.rot[4]},
		velocity = {self.vel[1], self.vel[2], self.vel[3]},
		angular_velocity = {self.ang[1], self.ang[2], self.ang[3]},
		friction = 0.5,
		bounciness = 0,
		drag = 0,
		rotational_drag = 0,
	}
	self:tune_suspension()
	self:build_anti_roll()
	self:read_body()
	self:build_wheels()
	self.ids = visual.create(world.scene, self.parts, self.entries, self.basis, nil, false)
	self.wheel_scratch = {pos = {0, 0, 0}, look = {0, 0, -1}, up = {0, 1, 0}}
	self:post_update(0)
	visual.snap(world.scene, self.ids)
end

function vehicle:build_wheels()
	local world = self.world
	local b = self.basis
	local body = self.body
	local v = body:velocity()
	local a = body:angular_velocity()
	self.wheel_bodies = {}
	for i, w in ipairs(self.prefab.wheels) do
		local susp, tire = self.suspensions[i], self.tires[i]
		local sp = susp.prefab
		local m = w.mount
		local down = sp.travel
		local mx, my, mz = m[1], m[2] - down, m[3]
		local px = b.px + b.xx * mx + b.yx * my + b.zx * mz
		local py = b.py + b.xy * mx + b.yy * my + b.zy * mz
		local pz = b.pz + b.xz * mx + b.yz * my + b.zz * mz
		local rx, ry, rz = px - b.px, py - b.py, pz - b.pz
		local wheel = world.phys:add_body{
			shape = "sphere",
			radius = tire.prefab.radius,
			mass = tire.prefab.mass,
			pos = {px, py, pz},
			velocity = {v[1] + a[2] * rz - a[3] * ry, v[2] + a[3] * rx - a[1] * rz, v[3] + a[1] * ry - a[2] * rx},
			friction = 0,
			bounciness = 0,
			drag = 0,
			rotational_drag = 0,
			group = -self.id,
		}
		wheel:attach(self.body, {mount = {m[1], m[2], m[3]}, travel = sp.travel, hertz = 30, damping = 10})
		self.wheel_bodies[i] = wheel
	end
end

function vehicle:on_unload()
	self:sync_state()
	if self.wheel_bodies then
		for _, wb in ipairs(self.wheel_bodies) do wb:remove() end
		self.wheel_bodies = nil
	end
	if self.body then
		self.body:remove()
		self.body = nil
	end
	if self.ids then
		visual.destroy(self.world.scene, self.ids)
		self.ids = nil
	end
end

function vehicle:read_body()
	local body = self.body
	local p = body:position()
	self.pos[1], self.pos[2], self.pos[3] = p[1], p[2], p[3]
	local x, y, z = body:axes()
	local b = self.basis
	if not b then
		b = {}
		self.basis = b
	end
	b.px, b.py, b.pz = p[1], p[2], p[3]
	b.xx, b.xy, b.xz = x[1], x[2], x[3]
	b.yx, b.yy, b.yz = y[1], y[2], y[3]
	b.zx, b.zy, b.zz = z[1], z[2], z[3]
end

function vehicle:sync_state()
	local body = self.body
	if not body then return end
	local r = body:rotation()
	self.rot[1], self.rot[2], self.rot[3], self.rot[4] = r[1], r[2], r[3], r[4]
	local v = body:velocity()
	self.vel[1], self.vel[2], self.vel[3] = v[1], v[2], v[3]
	local a = body:angular_velocity()
	self.ang[1], self.ang[2], self.ang[3] = a[1], a[2], a[3]
	local p = body:position()
	self.pos[1], self.pos[2], self.pos[3] = p[1], p[2], p[3]
end

function vehicle:seat_position()
	local b = self.basis
	local s = self.prefab.seat
	if not b then return self.pos[1], self.pos[2], self.pos[3] end
	return b.px + b.xx * s[1] + b.yx * s[2] + b.zx * s[3], b.py + b.xy * s[1] + b.yy * s[2] + b.zy * s[3], b.pz + b.xz * s[1] + b.yz * s[2] + b.zz * s[3]
end

function vehicle:camera_anchor()
	return self.pos[1], self.pos[2], self.pos[3]
end

function vehicle:heading_yaw()
	local b = self.basis
	if not b then return self.yaw end
	return atan2(b.zx, b.zz)
end

function vehicle:set_controls(throttle, steer, handbrake)
	local c = self.controls
	c.throttle, c.steer, c.handbrake = throttle, steer, handbrake
end

function vehicle:right_itself()
	local body = self.body
	if not body then return end
	local yaw = self:heading_yaw()
	local p = body:position()
	body:set_rotation(quat_from_yaw(yaw))
	body:set_position({p[1], p[2] + 1.2, p[3]})
	body:set_velocity({0, 0, 0})
	body:set_angular_velocity({0, 0, 0})
	body:wake()
end

function vehicle:wheelbase()
	local cached = self.wheelbase_value
	if cached then return cached end
	local steered, fixed, ns, nf = 0, 0, 0, 0
	for _, w in ipairs(self.prefab.wheels) do
		if w.steer ~= 0 then
			steered, ns = steered + w.mount[3], ns + 1
		else
			fixed, nf = fixed + w.mount[3], nf + 1
		end
	end
	local value = 2.5
	if ns > 0 and nf > 0 then value = abs(steered / ns - fixed / nf) end
	self.wheelbase_value = value
	return value
end

function vehicle:steer_limit(speed)
	local cfg = self.prefab.steering
	local tp = self.tires[1].prefab
	for i, w in ipairs(self.prefab.wheels) do
		if w.steer ~= 0 then
			tp = self.tires[i].prefab
			break
		end
	end
	local peak_slip = math.atan(3 * tp.grip / tp.stiffness)
	local v2 = speed * speed
	if v2 < 1e-3 then return cfg.max_angle end
	return min(cfg.max_angle, math.atan(tp.grip * G * self:wheelbase() / v2) + peak_slip)
end

function vehicle:update(dt)
	local c = self.controls
	local steer_cfg = self.prefab.steering
	local limit = self:steer_limit(abs(self.forward_speed))
	local target = c.steer * limit
	self.steer = util.approach(self.steer, target, steer_cfg.rate * dt)
	local p = self.pedal
	p.throttle = util.approach(p.throttle, c.throttle, PEDAL_RATE * dt)
	p.handbrake = util.approach(p.handbrake, c.handbrake, BRAKE_RATE * dt)
end

function vehicle:tune_suspension()
	local wheels = self.prefab.wheels
	local n = #wheels
	local mass = self.prefab.chassis.mass
	local sx, sz, sxx, sxz, szz = 0, 0, 0, 0, 0
	for _, w in ipairs(wheels) do
		local x, z = w.mount[1], w.mount[3]
		sx, sz = sx + x, sz + z
		sxx, sxz, szz = sxx + x * x, sxz + x * z, szz + z * z
	end
	local m = {{n, sx, sz}, {sx, sxx, sxz}, {sz, sxz, szz}}
	local det = m[1][1] * (m[2][2] * m[3][3] - m[2][3] * m[3][2]) - m[1][2] * (m[2][1] * m[3][3] - m[2][3] * m[3][1]) + m[1][3] * (m[2][1] * m[3][2] - m[2][2] * m[3][1])
	local lam = {0, 0, 0}
	if abs(det) > 1e-9 then
		local function solve_col(col)
			local out = {}
			for k = 1, 3 do
				local t = {{m[1][1], m[1][2], m[1][3]}, {m[2][1], m[2][2], m[2][3]}, {m[3][1], m[3][2], m[3][3]}}
				for r = 1, 3 do t[r][k] = col[r] end
				out[k] = (t[1][1] * (t[2][2] * t[3][3] - t[2][3] * t[3][2]) - t[1][2] * (t[2][1] * t[3][3] - t[2][3] * t[3][1]) + t[1][3] * (t[2][1] * t[3][2] - t[2][2] * t[3][1])) / det
			end
			return out
		end
		lam = solve_col({1, 0, 0})
	end
	for i, w in ipairs(wheels) do
		local share = lam[1] + lam[2] * w.mount[1] + lam[3] * w.mount[3]
		if share < 0.05 then share = 0.05 end
		self.suspensions[i]:tune(mass * share)
	end
end

function vehicle:build_anti_roll()
	local pairs_list = {}
	local axles = {}
	for i, w in ipairs(self.prefab.wheels) do
		if w.axle then
			local a = axles[w.axle]
			if not a then
				a = {}
				axles[w.axle] = a
			end
			a[#a + 1] = i
		end
	end
	for _, a in pairs(axles) do
		if #a == 2 then
			pairs_list[#pairs_list + 1] = {a[1], a[2], (self.suspensions[a[1]].bar + self.suspensions[a[2]].bar) / 2}
		end
	end
	self.anti_roll_pairs = pairs_list
end

function vehicle:step(h)
	local body = self.body
	if not body then return end
	local prefab = self.prefab
	local c = self.controls
	local pedal = self.pedal

	local pp = body:position()
	local px, py, pz = pp[1], pp[2], pp[3]
	local vel = body:velocity()
	local ang = body:angular_velocity()
	local ax, ay, az = body:axes()
	local rxx, rxy, rxz = ax[1], ax[2], ax[3]
	local ryx, ryy, ryz = ay[1], ay[2], ay[3]
	local fx_, fy_, fz_ = -az[1], -az[2], -az[3]
	local vx, vy, vz = vel[1], vel[2], vel[3]
	local wx, wy, wz = ang[1], ang[2], ang[3]
	local forward_speed = vx * fx_ + vy * fy_ + vz * fz_
	self.forward_speed = forward_speed

	local throttle = pedal.throttle
	local drive_input, brake_input = 0, 0
	if throttle > 0 then
		if forward_speed < -1 then brake_input = throttle else drive_input = throttle end
	elseif throttle < 0 then
		if forward_speed > 1 then brake_input = -throttle else drive_input = throttle end
	end
	local handbrake_input = pedal.handbrake
	if self.driver_id == nil and abs(forward_speed) < 1.5 then handbrake_input = 1 end

	local suspensions, tires, wheels = self.suspensions, self.tires, prefab.wheels
	local wheel_bodies = self.wheel_bodies
	local count = self.wheel_count
	local steer = self.steer
	local grounded_count = 0
	for i = 1, count do
		local susp = suspensions[i]
		local comp, rate = wheel_bodies[i]:suspension()
		susp:read_wheel(comp, rate, wheel_bodies[i]:contact())
		if susp.grounded then grounded_count = grounded_count + 1 end
	end

	local extra = self.extra_force
	if not extra then
		extra = {}
		self.extra_force = extra
	end
	for i = 1, count do extra[i] = 0 end
	for _, pair in ipairs(self.anti_roll_pairs) do
		local a, b, k = pair[1], pair[2], pair[3]
		local diff = (suspensions[a].compression - suspensions[b].compression) * k
		extra[a] = extra[a] + diff
		extra[b] = extra[b] - diff
	end

	local force = self.force_scratch
	if not force then
		force = {0, 0, 0}
		self.force_scratch = force
	end
	local point = self.point_scratch
	if not point then
		point = {0, 0, 0}
		self.point_scratch = point
	end

	local engine = prefab.engine
	local reverse = drive_input < 0
	local wheel_top = (reverse and REVERSE_SPEED or engine.top_speed)
	local drive_total, brake_total, hand_total = self.drive_total, self.brake_total, self.hand_total
	local brake_demand = brake_input * prefab.brake_torque
	local hand_demand = handbrake_input * prefab.brake_torque

	for i = 1, count do
		local w = wheels[i]
		local susp, tire = suspensions[i], tires[i]
		local tp = tire.prefab
		local spring = susp:solve() + extra[i]
		if spring < 0 then spring = 0 end
		wheel_bodies[i]:apply_spring(spring)

		local torque = 0
		if drive_input ~= 0 and w.drive > 0 then
			local share = w.drive / drive_total
			local omega = abs(tire.omega)
			local limit = engine.torque
			local by_power = engine.power / max(omega, 4)
			if by_power < limit then limit = by_power end
			if reverse then limit = limit * REVERSE_TORQUE end
			local top = wheel_top / tp.radius
			local fade = clamp((top - omega * (tire.omega * drive_input >= 0 and 1 or 0)) / (0.05 * top), 0, 1)
			torque = drive_input * limit * share * fade
		end
		local brake = 0
		if brake_total > 0 then brake = brake_demand * w.brake / brake_total end
		if hand_total > 0 then brake = brake + hand_demand * w.handbrake / hand_total end

		if susp.grounded then
			local nx, ny, nz = susp.normal_x, susp.normal_y, susp.normal_z
			local angle = steer * w.steer
			local ca, sa = cos(angle), sin(angle)
			local f0x, f0y, f0z = fx_ * ca + rxx * sa, fy_ * ca + rxy * sa, fz_ * ca + rxz * sa
			local dn = f0x * nx + f0y * ny + f0z * nz
			local gx, gy, gz = f0x - nx * dn, f0y - ny * dn, f0z - nz * dn
			local gl = sqrt(gx * gx + gy * gy + gz * gz)
			if gl < 1e-6 then gx, gy, gz, gl = f0x, f0y, f0z, 1 end
			gx, gy, gz = gx / gl, gy / gl, gz / gl
			local sx, sy, sz = gy * nz - gz * ny, gz * nx - gx * nz, gx * ny - gy * nx
			local cx, cy, cz = susp.contact_x, susp.contact_y, susp.contact_z
			local rx, ry, rz = cx - px, cy - py, cz - pz
			local cvx = vx + wy * rz - wz * ry
			local cvy = vy + wz * rx - wx * rz
			local cvz = vz + wx * ry - wy * rx
			local vf = cvx * gx + cvy * gy + cvz * gz
			local vr = cvx * sx + cvy * sy + cvz * sz
			local fx, fy = tire:solve(h, true, susp.load, vf, vr, torque, brake)
			tire.cx, tire.cy, tire.cz = cx, cy, cz
			local tfx, tfy, tfz = gx * fx + sx * fy, gy * fx + sy * fy, gz * fx + sz * fy
			force[1], force[2], force[3] = tfx, tfy, tfz
			body:apply_force(force, susp.contact_point)
			local other = susp.hit_body
			if other then
				force[1], force[2], force[3] = -tfx, -tfy, -tfz
				other:apply_force(force, susp.contact_point)
			end
		else
			tire:solve(h, false, 0, 0, 0, torque, brake)
		end
	end

	local speed2 = vx * vx + vy * vy + vz * vz
	if speed2 > 1e-6 then
		local speed = sqrt(speed2)
		local aero = prefab.aero
		local k = -0.5 * AIR_DENSITY * aero.drag * speed
		force[1], force[2], force[3] = vx * k, vy * k, vz * k
		body:apply_force(force)
		if aero.downforce > 0 then
			local d = -0.5 * AIR_DENSITY * aero.downforce * speed2
			force[1], force[2], force[3] = ryx * d, ryy * d, ryz * d
			body:apply_force(force)
		end
	end
	self.grounded_count = grounded_count
end

function vehicle:post_update(dt)
	local body = self.body
	if not body then return end
	self:read_body()
	local b = self.basis
	local v = body:velocity()
	local vx, vy, vz = v[1], v[2], v[3]
	self.speed_value = sqrt(vx * vx + vy * vy + vz * vz)
	self.vel[1], self.vel[2], self.vel[3] = vx, vy, vz

	local emitter = self.world.particles
	local tires = self.tires
	for i = 1, self.wheel_count do
		emitter:slide(tires[i], dt, vx, vy, vz)
	end

	local ids = self.ids
	local list = self.world.scene
	local n = self.chassis_part_count
	visual.pose(list, ids, self.parts, 1, n, b.px, b.py, b.pz, b.xx, b.xy, b.xz, b.yx, b.yy, b.yz, b.zx, b.zy, b.zz)

	local wheels = self.prefab.wheels
	local scratch = self.wheel_scratch
	local pos, look, up = scratch.pos, scratch.look, scratch.up
	local steer = self.steer
	local fx_, fy_, fz_ = -b.zx, -b.zy, -b.zz
	for i = 1, self.wheel_count do
		local id = ids[n + i]
		if id then
			local w = wheels[i]
			local susp, tire = self.suspensions[i], self.tires[i]
			local wp = self.wheel_bodies[i]:position()
			pos[1], pos[2], pos[3] = wp[1], wp[2], wp[3]
			local angle = steer * w.steer
			local ca, sa = cos(angle), sin(angle)
			local f0x, f0y, f0z = fx_ * ca + b.xx * sa, fy_ * ca + b.xy * sa, fz_ * ca + b.xz * sa
			local r0x, r0y, r0z = b.xx * ca - fx_ * sa, b.xy * ca - fy_ * sa, b.xz * ca - fz_ * sa
			local spin = tire.spin
			local cs, ss = cos(spin), sin(spin)
			look[1], look[2], look[3] = f0x * cs - b.yx * ss, f0y * cs - b.yy * ss, f0z * cs - b.yz * ss
			up[1], up[2], up[3] = r0x, r0y, r0z
			list:set(id, scratch)
		end
	end
end

return vehicle
local object = require("game.object")
local visual = require("game.visual")
local util = require("game.util")

local player = object.extend("player")
player.dynamic = true

local sin, cos, sqrt, abs, atan2 = math.sin, math.cos, math.sqrt, math.abs, math.atan

function player:init(init)
	self.vel = init.vel and {init.vel[1], init.vel[2], init.vel[3]} or {0, 0, 0}
	self.vehicle_id = init.vehicle_id
	self.on_ground = false
	self.hull = nil
	self.ids = nil
	self.prompt = nil
end

function player:serialize()
	local t = object.types.player.super.serialize(self)
	t.vel = {self.vel[1], self.vel[2], self.vel[3]}
	t.vehicle_id = self.vehicle_id
	return t
end

function player:is_pinned()
	return true
end

function player:radius()
	return self.prefab.radius or 1.2
end

function player:reach()
	return self.prefab.reach
end

function player:camera_anchor()
	return self.pos[1], self.pos[2] + self.prefab.eye_height, self.pos[3]
end

function player:create_hull()
	local r = self.prefab.hull_radius
	self.hull = self.world.phys:add_hull{pos = {self.pos[1], self.pos[2] + r[2], self.pos[3]}, radius = r, velocity = {self.vel[1], self.vel[2], self.vel[3]}}
end

function player:on_load()
	local pose = {px = self.pos[1], py = self.pos[2], pz = self.pos[3]}
	pose.xx, pose.xy, pose.xz, pose.yx, pose.yy, pose.yz, pose.zx, pose.zy, pose.zz = visual.yaw_basis(self.yaw)
	self.ids = visual.create(self.world.scene, self.parts, self.entries, pose, nil, false)
	if not self.vehicle_id then
		self:create_hull()
	else
		visual.set_visible(self.world.scene, self.ids, false)
	end
end

function player:on_unload()
	self:sync_state()
	if self.hull then
		self.hull:remove()
		self.hull = nil
	end
	if self.ids then
		visual.destroy(self.world.scene, self.ids)
		self.ids = nil
	end
end

function player:sync_state()
	local hull = self.hull
	if hull then
		local p = hull:position()
		self.pos[1], self.pos[2], self.pos[3] = p[1], p[2] - self.prefab.hull_radius[2], p[3]
		local v = hull:velocity()
		self.vel[1], self.vel[2], self.vel[3] = v[1], v[2], v[3]
	end
end

function player:enter_vehicle(v)
	if self.vehicle_id or v.driver_id then return end
	self.vehicle_id = v.id
	v.driver_id = self.id
	if self.hull then
		self.hull:remove()
		self.hull = nil
	end
	visual.set_visible(self.world.scene, self.ids, false)
	self.vel[1], self.vel[2], self.vel[3] = 0, 0, 0
	self.world:set_focus(v.id)
	self.world:retarget_camera(v.id)
end

function player:exit_vehicle()
	local world = self.world
	local v = world.objects[self.vehicle_id]
	self.vehicle_id = nil
	if not v then
		self:create_hull()
		return
	end
	v.driver_id = nil
	v:set_controls(0, 0, 0)
	local b = v.basis
	local pr = self.prefab
	local side = pr.exit_offset
	local x = b.px - b.xx * side
	local z = b.pz - b.xz * side
	local y = b.py - b.xy * side + 1.0
	local hit = world.phys:raycast({x, y + 3, z}, {0, -1, 0}, 12)
	if hit and hit.kind == "world" then y = hit.point[2] + 0.05 end
	self.pos[1], self.pos[2], self.pos[3] = x, y, z
	local k = pr.exit_inherit_velocity
	self.vel[1], self.vel[2], self.vel[3] = v.vel[1] * k, 0, v.vel[3] * k
	self.yaw = v:heading_yaw()
	self:create_hull()
	visual.set_visible(world.scene, self.ids, true)
	world.scene:snap(self.ids[1])
	world:set_focus(self.id)
	world:retarget_camera(self.id)
end

function player:nearest_vehicle()
	local best, best_d2
	local limit = self.prefab.enter_radius
	limit = limit * limit
	local px, py, pz = self.pos[1], self.pos[2], self.pos[3]
	local list = self.world.vehicles
	for i = 1, #list do
		local v = list[i]
		if v.state == "resident" and v.body and not v.driver_id then
			local dx, dy, dz = v.pos[1] - px, v.pos[2] - py, v.pos[3] - pz
			local d2 = dx * dx + dz * dz + dy * dy * 0.25
			if d2 < limit and (not best_d2 or d2 < best_d2) then best, best_d2 = v, d2 end
		end
	end
	return best
end

function player:update(dt)
	local world = self.world
	local input = world.input
	local pr = self.prefab

	if self.vehicle_id then
		local v = world.objects[self.vehicle_id]
		if not v then
			self:exit_vehicle()
			return
		end
		self.prompt = "F: exit"
		if input:hit("interact") then
			self:exit_vehicle()
			return
		end
		if input:hit("reset_vehicle") then v:right_itself() end
		v:set_controls(input:axis("backward", "forward"), input:axis("left", "right"), input:held("handbrake") and 1 or 0)
		return
	end

	local hull = self.hull
	if not hull then return end

	local near = self:nearest_vehicle()
	self.prompt = near and "F: enter vehicle" or nil
	if near and input:hit("interact") then
		self:enter_vehicle(near)
		return
	end

	local cam = world.camera
	local cam_yaw = cam and cam.yaw or 0
	local ix, iz = input:axis("left", "right"), input:axis("backward", "forward")
	local sy, cy = sin(cam_yaw), cos(cam_yaw)
	local dx = cy * ix - sy * iz
	local dz = -sy * ix - cy * iz
	local len = sqrt(dx * dx + dz * dz)
	if len > 1 then dx, dz = dx / len, dz / len end

	local vel = self.vel
	local tvx, tvz = dx * pr.walk_speed, dz * pr.walk_speed
	local grounded = hull:on_ground()
	self.on_ground = grounded
	local rate = grounded and pr.accel or pr.air_accel
	if len == 0 and grounded then rate = pr.brake end
	local ddx, ddz = tvx - vel[1], tvz - vel[3]
	local dl = sqrt(ddx * ddx + ddz * ddz)
	local maxd = rate * dt
	local nvx, nvz = tvx, tvz
	if dl > maxd then
		nvx, nvz = vel[1] + ddx / dl * maxd, vel[3] + ddz / dl * maxd
	end
	hull:set_velocity(nvx, nil, nvz)
	if input:held("jump") then hull:jump(pr.jump_speed) end

	if len > 0.1 then
		local target = atan2(-dx, -dz)
		self.yaw = util.approach_angle(self.yaw, target, pr.turn_rate * dt)
	end
end

function player:post_update(dt)
	local world = self.world
	local hull = self.hull
	if hull then
		self:sync_state()
		self.speed_value = sqrt(self.vel[1] ^ 2 + self.vel[2] ^ 2 + self.vel[3] ^ 2)
	else
		local v = world.objects[self.vehicle_id]
		if v then
			local x, y, z = v:seat_position()
			self.pos[1], self.pos[2], self.pos[3] = x, y - 0.9, z
			self.speed_value = v.speed_value
		end
	end
	if self.ids and hull then
		local xx, xy, xz, yx, yy, yz, zx, zy, zz = visual.yaw_basis(self.yaw)
		visual.pose(world.scene, self.ids, self.parts, 1, #self.ids, self.pos[1], self.pos[2], self.pos[3], xx, xy, xz, yx, yy, yz, zx, zy, zz)
	end
end

return player
local object = require("game.object")
local util = require("game.util")

local camera = object.extend("camera")
camera.dynamic = true

local sqrt, atan2, abs = math.sqrt, math.atan, math.abs
local clamp = util.clamp

function camera:init(init)
	self.target_id = init.target_id
	self.mode = init.mode or "follow"
	self.yaw = init.yaw or 0
	self.pitch = init.pitch or self.prefab.pitch
	self.distance = init.distance
	self.idle_time = 0
	self.anchor = {self.pos[1], self.pos[2], self.pos[3]}
	self.snap_next = true
	self.view = {camera = nil, far = self.prefab.far, near = self.prefab.near}
	self.instance = nil
	self.placement = {pos = {0, 0, 0}, look = {0, 0, -1}, up = {0, 1, 0}, fov = self.prefab.fov}
end

function camera:serialize()
	local t = object.types.camera.super.serialize(self)
	t.target_id = self.target_id
	t.mode = self.mode
	t.yaw = self.yaw
	t.pitch = self.pitch
	t.distance = self.distance
	return t
end

function camera:is_pinned()
	return true
end

function camera:acquire_assets()
	self.entries = {}
end

function camera:assets_ready()
	return true
end

function camera:ensure_assets_now() end

function camera:release_assets()
	self.entries = nil
end

function camera:on_load()
	self.instance = self.world.scene:add_camera({pos = self.pos, look = {0, 0, -1}, fov = self.prefab.fov})
	self.view.camera = self.instance
end

function camera:on_unload()
	if self.instance then
		self.world.scene:remove(self.instance)
		self.instance = nil
	end
end

function camera:set_target(id)
	self.target_id = id
	self.snap_next = true
end

function camera:update(dt)
	local input = self.world.input
	local p = self.prefab
	local dx, dy = input.mouse_dx, input.mouse_dy
	local key_yaw = input:axis("look_right", "look_left")
	local key_pitch = input:axis("look_down", "look_up")
	if dx ~= 0 or dy ~= 0 or key_yaw ~= 0 or key_pitch ~= 0 then self.idle_time = 0 else self.idle_time = self.idle_time + dt end
	self.yaw = self.yaw - dx * p.sensitivity + key_yaw * p.key_turn_rate * dt
	self.pitch = clamp(self.pitch - dy * p.sensitivity + key_pitch * p.key_turn_rate * dt, p.min_pitch, p.max_pitch)
end

function camera:post_update(dt)
	local world = self.world
	local target = world.objects[self.target_id]
	if not target then return end
	local p = self.prefab
	local cfg = p.follow[target.type] or p.follow.default
	local tx, ty, tz = target:camera_anchor()
	ty = ty + cfg.height
	local a = self.anchor
	if self.snap_next then
		a[1], a[2], a[3] = tx, ty, tz
	else
		local k = 1 - math.exp(-cfg.anchor_rate * dt)
		a[1], a[2], a[3] = a[1] + (tx - a[1]) * k, a[2] + (ty - a[2]) * k, a[3] + (tz - a[3]) * k
	end

	if target.type == "vehicle" and cfg.auto_align > 0 and self.idle_time > cfg.auto_align_delay then
		local speed = target.speed_value
		if speed > cfg.auto_align_speed then
			local heading = target:heading_yaw()
			if target.forward_speed < 0 then heading = heading + math.pi end
			local strength = clamp((speed - cfg.auto_align_speed) / 10, 0, 1)
			self.yaw = util.approach_angle(self.yaw, heading, cfg.auto_align * strength * dt)
		end
	end

	local lx, ly, lz = util.view_vector(self.yaw, self.pitch)
	local distance = self.distance or cfg.distance
	local hit = world.phys:raycast(a, {-lx, -ly, -lz}, distance + p.collision_margin)
	if hit then
		distance = clamp(hit.distance - p.collision_margin, p.min_distance, distance)
	end
	local pl = self.placement
	pl.pos[1], pl.pos[2], pl.pos[3] = a[1] - lx * distance, a[2] - ly * distance, a[3] - lz * distance
	pl.look[1], pl.look[2], pl.look[3] = lx, ly, lz
	local fov = cfg.fov or p.fov
	if target.type == "vehicle" then fov = fov + clamp(target.speed_value / cfg.fov_speed_ref, 0, 1) * cfg.fov_speed_gain end
	pl.fov = fov
	self.pos[1], self.pos[2], self.pos[3] = pl.pos[1], pl.pos[2], pl.pos[3]
	world.scene:set(self.instance, pl)
	if self.snap_next then
		world.scene:snap(self.instance)
		self.snap_next = false
	end
end

return camera
local util = require("game.util")

local demo = {}

local function clear_of(x, z, rects)
	for i = 1, #rects do
		local r = rects[i]
		local dx, dz = x - r[1], z - r[2]
		if dx * dx + dz * dz < r[3] * r[3] then return false end
	end
	return true
end

function demo.build(world, opts)
	opts = opts or {}
	local half = opts.tiles or 4
	for i = -half, half do
		for j = -half, half do
			world:spawn("world_object", "ground_tile", {pos = {i * 64, 0, j * 64}})
		end
	end

	local ramps = {
		{0, -70, 0},
		{45, -40, math.pi / 2},
		{-60, 30, -math.pi / 2},
		{20, 90, math.pi},
	}
	local keep_out = {{0, 0, 30}}
	for _, r in ipairs(ramps) do
		world:spawn("world_object", "ramp", {pos = {r[1], 0, r[2]}, yaw = r[3]})
		keep_out[#keep_out + 1] = {r[1], r[2], 22}
	end
	world:spawn("world_object", "mound", {pos = {0, 0, -130}})
	keep_out[#keep_out + 1] = {0, -130, 14}

	for k = 0, 9 do
		world:spawn("world_object", "bump", {pos = {-25, 0, -30 - k * 11}})
		keep_out[#keep_out + 1] = {-25, -30 - k * 11, 8}
	end

	local rand = util.rng(opts.seed or 1337)
	local extent = half * 64 + 30
	local kinds = {{"tree", 0.45}, {"rock", 0.7}, {"crate", 0.9}, {"pillar", 1.0}}
	local count = opts.scatter or 650
	local placed = 0
	while placed < count do
		local x = (rand() * 2 - 1) * extent
		local z = (rand() * 2 - 1) * extent
		if clear_of(x, z, keep_out) then
			local roll = rand()
			local kind = "tree"
			for _, k in ipairs(kinds) do
				if roll <= k[2] then kind = k[1] break end
			end
			local scale = 0.8 + rand() * 0.7
			local init = {pos = {x, 0, z}, yaw = rand() * math.pi * 2}
			if kind == "tree" or kind == "rock" then init.scale = scale end
			if kind == "crate" then
				for s = 0, 2 do
					world:spawn("prop", "crate", {pos = {x + s * 1.3, 0, z + (s % 2) * 0.4}, yaw = rand() * 0.6})
				end
				world:spawn("prop", "crate", {pos = {x + 0.6, 1.2, z + 0.2}, yaw = rand() * 0.6})
			else
				world:spawn("world_object", kind, init)
			end
			placed = placed + 1
		end
	end

	local buggy = world:spawn("vehicle", "buggy", {pos = {7, 1.4, 6}})
	local crawler = world:spawn("vehicle", "crawler", {pos = {-9, 1.6, 6}, yaw = 0})
	local hotrod = world:spawn("vehicle", "hotrod", {pos = {-20, 1.6, 6}, yaw = 0})
	local player = world:spawn("player", "default", {pos = {0, 0.4, 10}})
	local cam = world:spawn("camera", "chase", {target_id = player.id, yaw = 0, pos = {0, 3, 15}})
	world.player = player
	world.camera = cam
	world:set_focus(player.id)
	return {buggy = buggy, crawler = crawler, hotrod = hotrod, player = player, camera = cam}
end

return demo
